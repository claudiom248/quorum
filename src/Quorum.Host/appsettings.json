{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "ConnectionStrings": {
    "Platform": ""
  },
  "Database": {
    "StartupTimeout": "00:01:00"
  },
  "DataProtection": {
    "KeysPath": "/var/lib/quorum/keys"
  },
  "AllowedHosts": "*"
}
