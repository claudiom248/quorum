@page "/agents/assistants"
@inject QuorumApi Api
@inject IDialogService Dialogs

<PageTitle>Assistants · Quorum</PageTitle>

<MudStack Spacing="3" Class="list-page">
    <div>
        <MudText Typo="Typo.h5">Assistants</MudText>
        <MudText Typo="Typo.body2" Class="tool-hint">An assistant answers through its root agent. The limit says how many sub-agents may run at the same time in one answer.</MudText>
    </div>

    <ProblemMessage Problem="_problem" />

    @if (_assistants is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudTable T="AssistantInfo" Items="_assistants" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="list-grid" data-grid="assistants">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Root agent</MudTh>
                <MudTh>Parallel sub-agents</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="assistant">
                <MudTd DataLabel="Name"><span class="tool-name">@assistant.Name</span></MudTd>
                <MudTd DataLabel="Root agent">@assistant.RootAgentSlug</MudTd>
                <MudTd DataLabel="Parallel sub-agents">@assistant.MaxParallelSubAgents</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="() => Edit(assistant)">Edit</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(assistant)">Delete</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_form is null)
        {
            <div><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="New">Add assistant</MudButton></div>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-4">
                <form @onsubmit="SaveAsync" data-form="assistant">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">@(_editing is null ? "New assistant" : "Edit assistant")</MudText>
                        <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined" Required="true" />
                        <label class="tool-policy">Root agent
                            <select aria-label="Root agent" @bind="_form.RootAgentSlug">
                                <option value="">Choose an agent</option>
                                @foreach (var agent in _agents)
                                {
                                    <option value="@agent.Slug">@agent.DisplayName</option>
                                }
                            </select>
                        </label>
                        <MudNumericField T="int" @bind-Value="_form.MaxParallelSubAgents" Label="Sub-agents at the same time" Variant="Variant.Outlined" Min="1"
                                         HelperText="1 runs them one after the other." />
                        <ProblemMessage Problem="_formProblem" />
                        <MudStack Row="true" Spacing="2">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save</MudButton>
                            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="Cancel">Cancel</MudButton>
                        </MudStack>
                    </MudStack>
                </form>
            </MudPaper>
        }
    }
</MudStack>

@code {
    private sealed class AssistantForm
    {
        public string Name { get; set; } = string.Empty;

        public string RootAgentSlug { get; set; } = string.Empty;

        public int MaxParallelSubAgents { get; set; } = 1;
    }

    private List<AssistantInfo>? _assistants;
    private List<AgentListItem> _agents = [];
    private AssistantInfo? _editing;
    private AssistantForm? _form;
    private ApiProblem? _problem;
    private ApiProblem? _formProblem;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var agents = await Api.ListAgentItemsAsync();
        _agents = agents.IsSuccess ? agents.Value : [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.ListAssistantInfosAsync();
        _problem = result.Problem;
        _assistants = result.IsSuccess ? result.Value : [];
    }

    private void New()
    {
        _editing = null;
        _form = new AssistantForm();
        _formProblem = null;
    }

    private void Edit(AssistantInfo assistant)
    {
        _editing = assistant;
        _form = new AssistantForm { Name = assistant.Name, RootAgentSlug = assistant.RootAgentSlug, MaxParallelSubAgents = assistant.MaxParallelSubAgents };
        _formProblem = null;
    }

    private void Cancel() => _form = null;

    private async Task SaveAsync()
    {
        if (_form is null || _busy)
        {
            return;
        }

        _busy = true;
        var request = new AssistantRequest(_form.Name.Trim(), _form.RootAgentSlug, _form.MaxParallelSubAgents);
        var result = _editing is null
            ? await Api.CreateAssistantAsync(request)
            : await Api.UpdateAssistantAsync(_editing.Id, request);
        _busy = false;

        _formProblem = result.Problem;
        if (result.IsSuccess)
        {
            _form = null;
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(AssistantInfo assistant)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete assistant", $"Delete {assistant.Name}? Its conversations stay readable.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var result = await Api.DeleteAssistantAsync(assistant.Id);
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            await LoadAsync();
        }
    }
}
