@page "/settings"
@inject QuorumApi Api
@inject OnboardingProgress Onboarding
@inject NavigationManager Navigation

<PageTitle>Settings · Quorum</PageTitle>

<div class="settings">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Assistant settings</MudText>

    @if (Unverified is not null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            The model could not be reached during setup. Check the endpoint below and use "Test connection".
        </MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_model is not null)
    {
        @* Each tab saves on its own and says so; the others keep what was last saved. *@
        <MudTabs @bind-ActivePanelIndex="_tab" @bind-ActivePanelIndex:after="TabChangedAsync" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            <MudTabPanel Text="Model" data-tab="model">
                <form @onsubmit="SaveModelAsync">
                    <MudStack Spacing="3">
                        <ModelConnectionForm Value="_model" HasApiKey="_hasApiKey" Busy="_busy" Test="TestModelAsync" />
                        <ProblemMessage Problem="_modelProblem" />
                        @if (_modelSaved)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">Model settings saved.</MudAlert>
                        }

                        <MudStack Row="true" Justify="Justify.FlexEnd">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save model</MudButton>
                        </MudStack>
                    </MudStack>
                </form>
            </MudTabPanel>

            <MudTabPanel Text="Behaviour" data-tab="behaviour">
                <form @onsubmit="SaveBehaviourAsync">
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_prompt" Label="System prompt" Variant="Variant.Outlined" Lines="10" />
                        <ProblemMessage Problem="_behaviourProblem" />
                        @if (_behaviourSaved)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">Behaviour saved.</MudAlert>
                        }

                        <MudStack Row="true" Justify="Justify.FlexEnd">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save behaviour</MudButton>
                        </MudStack>
                    </MudStack>
                </form>
            </MudTabPanel>

            @if (_pool is { Count: > 0 })
            {
                <MudTabPanel Text="Tools" data-tab="tools">
                    <form @onsubmit="SaveToolsAsync">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" Class="tools-support-hint">
                                The tools the assistant may call. Each one runs under its own policy; those that need confirmation ask the person chatting before they run.
                            </MudText>

                            @if (!_model.SupportsTools)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    The model is marked as not supporting tools, so none of these are offered to it.
                                </MudAlert>
                            }

                            <MudTextField T="string" @bind-Value="_toolSearch" Label="Search the tools" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                          Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

                            @foreach (var group in Groups())
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-2" data-source="@group.Source">@group.Source</MudText>
                                @foreach (var tool in group.Tools)
                                {
                                    <MudCheckBox T="bool" @bind-Value="tool.Active" Label="@tool.Label" Color="Color.Primary" Dense="true" />
                                }
                            }

                            @foreach (var warning in _warnings)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@warning.Message</MudAlert>
                            }

                            <ProblemMessage Problem="_toolsProblem" />
                            @if (_toolsSaved)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">Tools saved.</MudAlert>
                            }

                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save tools</MudButton>
                            </MudStack>
                        </MudStack>
                    </form>
                </MudTabPanel>
            }

            <MudTabPanel Text="Integrations" data-tab="integrations">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body2">
                        Service tokens let an external process (an ETL, a scheduled job) trigger the refresh of a knowledge base's lookups
                        as soon as it finishes writing. A token reaches the refresh and its status only, and only for the knowledge bases
                        of this tenant.
                    </MudText>

                    @if (_tokensProblem is not null)
                    {
                        <ProblemMessage Problem="_tokensProblem" />
                    }

                    @if (_newToken is not null)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="py-3">
                            <MudStack Spacing="2">
                                <MudText>Copied this token into your ETL configuration now: it <strong>will not be shown again</strong>.</MudText>
                                <MudTextField Value="@_newToken.Token" Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense"
                                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                              data-token-plaintext />
                            </MudStack>
                        </MudAlert>
                    }

                    @if (_tokens.Count > 0)
                    {
                        <MudTable T="ServiceTokenInfo" Items="_tokens" Dense="true" Hover="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Created</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="token">
                                <MudTd DataLabel="Created">@token.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                               data-revoke-token="@token.Id"
                                               OnClick="() => RevokeTokenAsync(token.Id)">Revoke</MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No service token yet.</MudText>
                    }

                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GenerateTokenAsync">Generate</MudButton>
                    </MudStack>
                </MudStack>
            </MudTabPanel>

            @if (_webSearch)
            {
                @* One tab for the platform's single web row: three sections of one form, saved together. *@
                <MudTabPanel Text="Web" data-tab="web">
                    <form @onsubmit="SaveWebAsync">
                        <MudStack Spacing="4">
                            <MudText Typo="Typo.body2">
                                One row serves the whole installation: the SearXNG instance every web search asks, the defaults a web
                                fetch tool falls back on when its own fields are left empty, and how the platform behaves towards every
                                site it reads. A tool that overrides one of these numbers in its own form is not moved by changing it here.
                            </MudText>

                            @if (_webUrl is not { Length: > 0 })
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    No instance is set yet, so no web search tool can be created.
                                </MudAlert>
                            }

                            <MudDivider />
                            <MudText Typo="Typo.subtitle1">Search</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="8">
                                    <MudTextField T="string" @bind-Value="_webUrl" Label="Instance URL" Variant="Variant.Outlined" Required="true"
                                                  MaxLength="@WebSearchToolLimits.MaxUrlLength" data-web-search-url
                                                  HelperText="Where SearXNG answers, with its scheme: https://searxng.internal or http://localhost:8080." />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int" @bind-Value="_webTimeout" Label="Timeout (seconds)" Variant="Variant.Outlined"
                                                     Min="@WebSearchToolLimits.MinTimeoutSeconds" Max="@WebSearchToolLimits.MaxTimeoutSeconds" data-web-search-timeout
                                                     HelperText="How long one search may take, its retries included: past that the model is told the web is unavailable." />
                                </MudItem>
                            </MudGrid>

                            <MudDivider />
                            <MudText Typo="Typo.subtitle1">Reading defaults</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_webFetchTimeout" Label="Timeout per page (seconds)" Variant="Variant.Outlined"
                                                     Min="@WebConfigurationLimits.MinFetchTimeoutSeconds" Max="@WebConfigurationLimits.MaxFetchTimeoutSeconds" data-web-fetch-timeout
                                                     HelperText="A site that does not answer in time is reported to the model as not read, and the other pages of the call are kept." />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_webFetchMaxUrls" Label="Most pages per call" Variant="Variant.Outlined"
                                                     Min="@WebConfigurationLimits.MinFetchMaxUrlsPerInvocation" Max="@WebConfigurationLimits.MaxFetchMaxUrlsPerInvocation" data-web-fetch-urls
                                                     HelperText="Also written into the tool's description, so the model knows the limit before it asks." />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_webFetchPerPage" Label="Tokens per page" Variant="Variant.Outlined"
                                                     Min="@WebConfigurationLimits.MinFetchTokenBudgetPerPage" Max="@WebConfigurationLimits.MaxFetchTokenBudgetPerPage" data-web-fetch-per-page
                                                     HelperText="The rest of a longer article is cut, and the model is told the page was shortened." />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_webFetchTotal" Label="Tokens per call" Variant="Variant.Outlined"
                                                     Min="@WebConfigurationLimits.MinFetchTotalTokenBudget" Max="@WebConfigurationLimits.MaxFetchTotalTokenBudget" data-web-fetch-total
                                                     HelperText="What every page of one call costs together: the later pages get what is left, or nothing." />
                                </MudItem>
                            </MudGrid>

                            <MudDivider />
                            <MudText Typo="Typo.subtitle1">Politeness and memory</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="_userAgent" Label="User-Agent" Variant="Variant.Outlined" Required="true"
                                                  MaxLength="@WebConfigurationLimits.MaxUserAgentLength" data-user-agent
                                                  HelperText="Who the site sees asking. Quorum/1.0 says the software, not a fake browser." />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_fetchDelayMs" Label="Wait between pages (milliseconds)" Variant="Variant.Outlined"
                                                     Min="@WebConfigurationLimits.MinFetchDelayMs" Max="@WebConfigurationLimits.MaxFetchDelayMs" data-fetch-delay
                                                     HelperText="One reading does not send the whole batch of pages at once. Zero is allowed, and unfriendly to small sites." />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudStack Spacing="0">
                                        <MudCheckBox T="bool" @bind-Value="_respectRobotsTxt" Label="Respect robots.txt" Color="Color.Primary" Dense="true" data-respect-robots />
                                        <MudCheckBox T="bool" @bind-Value="_cacheEnabled" Label="Remember pages that were read" Color="Color.Primary" Dense="true" data-cache-enabled />
                                        <MudText Typo="Typo.caption">
                                            A site that forbids a page keeps it from the model; a robots.txt the platform cannot read blocks
                                            nothing. Saving these settings drops what was remembered, so a change answers at once.
                                        </MudText>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_cacheTtlMinutes" Label="Remember a page for (minutes)" Variant="Variant.Outlined"
                                                     Min="@WebConfigurationLimits.MinCacheTtlMinutes" Max="@WebConfigurationLimits.MaxCacheTtlMinutes" data-cache-ttl
                                                     HelperText="How old a remembered page may be before the site is asked again." />
                                </MudItem>
                            </MudGrid>

                            <ProblemMessage Problem="_webProblem" />
                            @if (_webSaved)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">Web settings saved.</MudAlert>
                            }

                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                                           data-save-web>Save web settings</MudButton>
                            </MudStack>
                        </MudStack>
                    </form>
                </MudTabPanel>
            }
        </MudTabs>
    }
    else
    {
        <ProblemMessage Problem="_loadProblem" />
    }
</div>

@code {
    private ModelConnectionFields? _model;
    private ModelConnectionFields _savedModel = new();
    private string _prompt = string.Empty;
    private string _savedPrompt = string.Empty;
    private bool _hasApiKey;
    private bool _loading = true;
    private bool _busy;
    private ApiProblem? _loadProblem;
    private ApiProblem? _modelProblem;
    private bool _modelSaved;
    private ApiProblem? _behaviourProblem;
    private bool _behaviourSaved;
    private Guid? _assistantId;
    private List<PoolEntry>? _pool;
    private IReadOnlyList<ToolWarning> _warnings = [];
    private ApiProblem? _toolsProblem;
    private bool _toolsSaved;
    private string? _toolSearch;
    private List<ServiceTokenInfo> _tokens = [];
    private ApiProblem? _tokensProblem;
    private CreatedServiceToken? _newToken;
    private bool _webSearch;
    private string? _webUrl;
    private int _webTimeout = WebSearchToolLimits.DefaultTimeoutSeconds;
    private WebConfigurationInfo? _webConfiguration;
    private ApiProblem? _webProblem;
    private bool _webSaved;
    private int _webFetchTimeout = WebConfigurationLimits.DefaultFetchTimeoutSeconds;
    private int _webFetchMaxUrls = WebConfigurationLimits.DefaultFetchMaxUrlsPerInvocation;
    private int _webFetchPerPage = WebConfigurationLimits.DefaultFetchTokenBudgetPerPage;
    private int _webFetchTotal = WebConfigurationLimits.DefaultFetchTotalTokenBudget;
    private string _userAgent = WebConfigurationLimits.DefaultUserAgent;
    private int _fetchDelayMs = WebConfigurationLimits.DefaultFetchDelayMs;
    private bool _respectRobotsTxt = true;
    private bool _cacheEnabled = true;
    private int _cacheTtlMinutes = WebConfigurationLimits.DefaultCacheTtlMinutes;
    private int _tab;

    private const int BehaviourTab = 1;

    [SupplyParameterFromQuery]
    public string? Unverified { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAssistantSettingsAsync();
        _loading = false;

        if (!result.IsSuccess)
        {
            _loadProblem = result.Problem;
            return;
        }

        var s = result.Value;
        _hasApiKey = s.HasApiKey;
        _model = new ModelConnectionFields
        {
            BaseUrl = s.BaseUrl,
            ModelName = s.ModelName,
            ContextTokenBudget = s.ContextTokenBudget,
            SupportsTools = s.SupportsTools,
        };
        _savedModel = _model.Copy();
        _prompt = _savedPrompt = s.SystemPrompt;

        await LoadToolsAsync();
        await LoadTokensAsync();
        await LoadWebSearchAsync();
    }

    private async Task LoadWebSearchAsync()
    {
        var configuration = await Api.GetWebConfigurationAsync();
        if (!configuration.IsSuccess)
        {
            // Only an administrator sees the instance: as with the tools tab, a refusal simply leaves the tab out.
            return;
        }

        _webSearch = true;
        _webConfiguration = configuration.Value;
        _webUrl = configuration.Value.SearchUrl;
        _webTimeout = configuration.Value.SearchTimeoutSeconds;

        // The Web tab is one row read at once: the instance, the fetch defaults and the properties come from the same answer.
        _webFetchTimeout = configuration.Value.FetchTimeoutSeconds;
        _webFetchMaxUrls = configuration.Value.FetchMaxUrlsPerInvocation;
        _webFetchPerPage = configuration.Value.FetchTokenBudgetPerPage;
        _webFetchTotal = configuration.Value.FetchTotalTokenBudget;
        _userAgent = configuration.Value.UserAgent;
        _fetchDelayMs = configuration.Value.FetchDelayMs;
        _respectRobotsTxt = configuration.Value.RespectRobotsTxt;
        _cacheEnabled = configuration.Value.CacheEnabled;
        _cacheTtlMinutes = configuration.Value.CacheTtlMinutes;
    }

    // One form, one write: the row is the platform's single one, so a field typed here and not saved cannot be overwritten by
    // another part of the same page, and two administrators see the same whole row.
    private async Task SaveWebAsync()
    {
        _busy = true;
        _webProblem = null;
        _webSaved = false;
        var updated = (_webConfiguration ?? WebConfigurationLimits.Defaults) with
        {
            SearchUrl = _webUrl,
            SearchTimeoutSeconds = _webTimeout,
            FetchTimeoutSeconds = _webFetchTimeout,
            FetchMaxUrlsPerInvocation = _webFetchMaxUrls,
            FetchTokenBudgetPerPage = _webFetchPerPage,
            FetchTotalTokenBudget = _webFetchTotal,
            UserAgent = _userAgent,
            FetchDelayMs = _fetchDelayMs,
            RespectRobotsTxt = _respectRobotsTxt,
            CacheEnabled = _cacheEnabled,
            CacheTtlMinutes = _cacheTtlMinutes,
        };
        var result = await Api.UpdateWebConfigurationAsync(updated);
        _busy = false;

        if (!result.IsSuccess)
        {
            _webProblem = result.Problem;
            return;
        }

        _webConfiguration = updated;
        _webSaved = true;
    }

    private async Task LoadTokensAsync()
    {
        var tokens = await Api.ListServiceTokensAsync();
        if (!tokens.IsSuccess)
        {
            _tokensProblem = tokens.Problem;
            return;
        }

        _tokens = [.. tokens.Value.OrderByDescending(t => t.CreatedAt)];
    }

    private async Task GenerateTokenAsync()
    {
        _busy = true;
        _tokensProblem = null;
        _newToken = null;
        var created = await Api.CreateServiceTokenAsync();
        _busy = false;

        if (!created.IsSuccess)
        {
            _tokensProblem = created.Problem;
            return;
        }

        _newToken = created.Value;
        _tokens = [.. _tokens.Where(t => t.Id != created.Value.Id).Prepend(new ServiceTokenInfo(created.Value.Id, created.Value.CreatedAt)).OrderByDescending(t => t.CreatedAt)];
    }

    private async Task RevokeTokenAsync(Guid id)
    {
        _tokensProblem = null;
        var result = await Api.RevokeServiceTokenAsync(id);
        if (!result.IsSuccess)
        {
            _tokensProblem = result.Problem;
            return;
        }

        _tokens = [.. _tokens.Where(t => t.Id != id)];
        if (_newToken?.Id == id)
        {
            _newToken = null;
        }
    }

    private async Task LoadToolsAsync()
    {
        var assistants = await Api.ListAssistantsAsync();
        if (!assistants.IsSuccess || assistants.Value.Count == 0)
        {
            return;
        }

        _assistantId = assistants.Value[0].Id;
        var tools = await Api.GetAssistantToolsAsync(_assistantId.Value);
        if (!tools.IsSuccess)
        {
            // Not everyone who may change the model may manage tools: the tab is simply absent.
            return;
        }

        _pool = tools.Value.Pool.Select(t => new PoolEntry(t.ToolId, ToolCallView.DisplayNameOf(t.Name), SourceOf(t.Name)) { Active = t.Active }).ToList();
        _warnings = tools.Value.Warnings;
    }

    // "files__read" comes from the server files, "builtin__calculator" is built in: the part before the double underscore.
    private static string SourceOf(string exposedName)
    {
        var split = exposedName.IndexOf("__", StringComparison.Ordinal);
        return split > 0 ? exposedName[..split] : "other";
    }

    private IEnumerable<(string Source, List<PoolEntry> Tools)> Groups() =>
        _pool!
            .Where(t => string.IsNullOrWhiteSpace(_toolSearch) || t.Label.Contains(_toolSearch.Trim(), StringComparison.OrdinalIgnoreCase))
            .GroupBy(t => t.Source)
            .OrderBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => (g.Key, g.ToList()));

    private Task<ApiResult<ModelConnection>> TestModelAsync(string baseUrl, string? key, string? model) => Api.TestAssistantModelAsync(baseUrl, key, model);

    // Opening the Behaviour tab once is what completes its step of the getting-started checklist; failing to record it is not the page's problem.
    private async Task TabChangedAsync()
    {
        if (_tab == BehaviourTab)
        {
            await Onboarding.MarkAsync("prompt");
        }
    }

    private Task SaveModelAsync() => SaveAsync(model: true);

    private Task SaveBehaviourAsync() => SaveAsync(model: false);

    // The tab that saves sends its own part and the other part as last saved, so an unsaved edit elsewhere is not saved by accident.
    private async Task SaveAsync(bool model)
    {
        _busy = true;
        _modelProblem = null;
        _behaviourProblem = null;
        _modelSaved = false;
        _behaviourSaved = false;

        var connection = model ? _model! : _savedModel;
        var prompt = model ? _savedPrompt : _prompt;
        var request = new UpdateAssistantSettingsRequest(
            connection.BaseUrl.Trim(),
            connection.ModelName.Trim(),
            model ? _model!.KeyToSend() : null,
            connection.ContextTokenBudget,
            prompt,
            connection.SupportsTools);
        var result = await Api.UpdateAssistantSettingsAsync(request);
        _busy = false;

        if (!result.IsSuccess)
        {
            if (model)
            {
                _modelProblem = result.Problem;
            }
            else
            {
                _behaviourProblem = result.Problem;
            }

            return;
        }

        if (model)
        {
            if (!string.IsNullOrWhiteSpace(_model!.ApiKey))
            {
                _hasApiKey = true;
            }

            if (_model.RemoveKey && string.IsNullOrWhiteSpace(_model.ApiKey))
            {
                _hasApiKey = false;
            }

            _model.ApiKey = null;
            _model.RemoveKey = false;
            _savedModel = _model.Copy();
            _modelSaved = true;
        }
        else
        {
            _savedPrompt = _prompt;
            _behaviourSaved = true;
        }

        if (Unverified is not null && model)
        {
            Navigation.NavigateTo("settings", replace: true);
        }
    }

    private async Task SaveToolsAsync()
    {
        if (_assistantId is not { } assistantId || _pool is null)
        {
            return;
        }

        _busy = true;
        _toolsProblem = null;
        _toolsSaved = false;
        var result = await Api.SetAssistantToolsAsync(assistantId, _pool.Where(t => t.Active).Select(t => t.ToolId).ToList());
        _busy = false;

        if (!result.IsSuccess)
        {
            _toolsProblem = result.Problem;
            return;
        }

        _toolsSaved = true;
        var tools = await Api.GetAssistantToolsAsync(assistantId);
        if (tools.IsSuccess)
        {
            _warnings = tools.Value.Warnings;
        }
    }

    private sealed record PoolEntry(Guid ToolId, string Label, string Source)
    {
        public bool Active { get; set; }
    }
}
