@page "/tools/rag"
@page "/tools/rag/{Id}"
@using System.Text.Json
@implements IDisposable
@inject QuorumApi Api
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>Rag tools · Quorum</PageTitle>

<ListPage Title="Rag tools"
          Description="A rag tool lets an assistant search one or more knowledge bases and cite what it finds. Which fields a model can filter on, and which filters it can never change, are decided here. Register the knowledge bases in Knowledge; activate a tool on an assistant in Settings."
          AddLabel="Add rag tool" OnAdd="() => _screen.OpenDrawer(ListScreen<RagToolListItem>.NewId)" Notice="@_notice"
          Loading="_screen.Loading" Problem="_screen.Items.Count == 0 ? _screen.Problem : null" OnRetry="_screen.ReloadAsync"
          IsEmpty="_screen.IsEmpty" HasFilters="_screen.Query.HasFilters" OnClearFilters="() => _screen.ChangeQueryAsync(ListQuery.Empty)"
          EmptyTitle="No rag tool is configured yet" EmptyText="Add one to let an assistant search a knowledge base.">
    <FilterContent>
        <FilterBar Query="_screen.Query" QueryChanged="_screen.ChangeQueryAsync" Tenants="_tenants" Assistants="_assistants"
                   StatusOptions="StatusOptions" SearchPlaceholder="Search by name or description" />
    </FilterContent>
    <ChildContent>
        <ProblemMessage Problem="_screen.Items.Count > 0 ? _screen.Problem ?? _problem : _problem" />
        <MudTable T="RagToolListItem" Items="_screen.Items" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="list-grid" data-grid="rag">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Knowledge bases</MudTh>
                <MudTh>Scope</MudTh>
                <MudTh>State</MudTh>
            </HeaderContent>
            <RowTemplate Context="tool">
                <MudTd DataLabel="Name">
                    <MudLink Href="@_screen.DrawerUri(tool.Id.ToString())" Class="tool-name" data-rag="@tool.Name">rag__@tool.Name</MudLink>
                    @foreach (var warning in tool.Warnings)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" data-warning="@warning.Code">@warning.Code</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Knowledge bases">
                    @foreach (var knowledgeBase in tool.KnowledgeBases)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@knowledgeBase.Name</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Scope"><ScopeBadge Scope="tool.Scope" Assistants="_assistants" Shared="tool.Shared" /></MudTd>
                <MudTd DataLabel="State">
                    <ToolStateCell @key="(tool.Id, _rowGeneration)" Tool="AsToolInfo(tool)" ReadOnly="tool.Shared" Busy="_busy" OnChange="ChangeToolAsync" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_screen.Cursor is not null)
        {
            <MudButton Variant="Variant.Outlined" Class="mt-3" Disabled="_screen.Loading" OnClick="_screen.LoadMoreAsync">Load more</MudButton>
        }
    </ChildContent>
</ListPage>

<ListDrawer @ref="_drawer" Open="Id is not null" Title="@DrawerTitle" Wide="true" Dirty="IsDirty" OnClose="_screen.CloseDrawer">
    @if (_form is null)
    {
        @if (_drawerProblem is not null)
        {
            <ProblemMessage Problem="_drawerProblem" />
        }
        else
        {
            <MudProgressLinear Indeterminate="true" />
        }
    }
    else
    {
        var form = _form;
        var choices = RagToolView.Candidates(form.KnowledgeBaseIds, _details, _dictionary);
        var exposed = choices.Fields.Where(f => form.ExposedFieldIds.Contains(f.Id)).ToList();
        <div data-form="rag">
        <form @onsubmit="SaveAsync">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" Required="true" MaxLength="40"
                              HelperText="Lower-case letters, digits, '-' and '_'. The model sees the tool as rag__name." />
                <MudTextField @bind-Value="form.Description" Label="Description" Variant="Variant.Outlined" Required="true" Lines="3" MaxLength="1000"
                              HelperText="For the model: when to search these knowledge bases. The knowledge bases' own descriptions are added to it." />

                <MudText Typo="Typo.subtitle2">Knowledge bases (@form.KnowledgeBaseIds.Count of @RagToolLimits.MaxKnowledgeBases)</MudText>
                @if (_bases.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        No knowledge base is registered yet. <MudLink Href="knowledge">Register one</MudLink> first.
                    </MudAlert>
                }

                @foreach (var knowledgeBase in _bases)
                {
                    var selected = form.KnowledgeBaseIds.Contains(knowledgeBase.Id);
                    <MudCheckBox T="bool" Value="selected" ValueChanged="on => ToggleKnowledgeBaseAsync(knowledgeBase, on)" Dense="true"
                                 Disabled="@(!selected && form.KnowledgeBaseIds.Count >= RagToolLimits.MaxKnowledgeBases)"
                                 Label="@(knowledgeBase.Shared ? $"{knowledgeBase.Name} (shared with you)" : knowledgeBase.Name)" />
                }

                @if (form.KnowledgeBaseIds.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">Fields the model can filter on (@form.ExposedFieldIds.Count of @RagToolLimits.MaxExposedFields)</MudText>
                    @if (!choices.Complete)
                    {
                        <div class="tool-hint">
                            A knowledge base shared with you does not show its mapping, so every dictionary field is offered.
                            The server refuses fields that none of the knowledge bases maps.
                        </div>
                    }

                    @if (choices.Fields.Count == 0)
                    {
                        <div class="tool-hint">These knowledge bases map no metadata field: the model can only send a question.</div>
                    }

                    @foreach (var (cluster, group) in KnowledgeAdminView.GroupByCluster(choices.Fields))
                    {
                        @if (cluster is not null)
                        {
                            <div class="tool-hint cluster-heading" data-cluster="@cluster">@cluster</div>
                        }

                        @foreach (var field in group)
                        {
                            var on = form.ExposedFieldIds.Contains(field.Id);
                            var label = KnowledgeAdminView.FieldLabel(field, choices.Fields);
                            <div class="exposed-field">
                                <MudCheckBox T="bool" Value="on" ValueChanged="value => ToggleExposed(field, value)" Dense="true"
                                             Disabled="@(!on && form.ExposedFieldIds.Count >= RagToolLimits.MaxExposedFields)"
                                             Label="@($"{label} ({KnowledgeAdminView.TypeLabel(field.Type).ToLowerInvariant()})")" />
                                @if (on)
                                {
                                    <MudTextField T="string" Value="@(form.Aliases.GetValueOrDefault(field.Id) ?? string.Empty)" ValueChanged="alias => form.SetAlias(field, alias)"
                                                  Label="@($"Alias of {label}")" Placeholder="@field.Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Immediate="true" Class="alias-input" HelperText="The name the model sees. Leave empty to use the field's name." />
                                }
                            </div>
                        }
                    }

                    <MudText Typo="Typo.subtitle2">Fixed filters</MudText>
                    <div class="tool-hint">
                        Always applied, combined with AND, never visible to the model and never overridden by it. Use them to carve a slice
                        of a knowledge base, such as one department. They may use fields that are not exposed.
                    </div>
                    @foreach (var id in form.FixedFilterFieldIds.ToList())
                    {
                        @if (_dictionary.FirstOrDefault(f => f.Id == id) is { } filterField)
                        {
                            <div class="fixed-filter" data-filter="@filterField.Name">
                                <div class="tool-row-head">
                                    <span class="tool-name">@KnowledgeAdminView.FieldLabel(filterField, _dictionary)</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Remove the filter on {filterField.Name}")"
                                                   OnClick="() => form.RemoveFixedFilter(id, _dictionary)" />
                                </div>
                                <FilterEditor Parameters="form.ParametersOf(filterField)" Values="form.FilterValues" />
                            </div>
                        }
                    }

                    @if (form.UnshownFilters.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            The stored filters include @string.Join(", ", form.UnshownFilters), which this editor cannot show (the field is gone).
                            Saving drops them.
                        </MudAlert>
                    }

                    @if (choices.Fields.Where(f => !form.FixedFilterFieldIds.Contains(f.Id)).ToList() is { Count: > 0 } available)
                    {
                        <label class="tool-policy">Add a fixed filter on
                            <select @key="form.FixedFilterFieldIds.Count" aria-label="Add a fixed filter" value="" @onchange="e => AddFixedFilter(e.Value?.ToString())">
                                <option value="">Choose a field…</option>
                                @foreach (var field in available)
                                {
                                    <option value="@field.Id">@KnowledgeAdminView.FieldLabel(field, choices.Fields)</option>
                                }
                            </select>
                        </label>
                    }

                    <MudText Typo="Typo.subtitle2">Retrieval</MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudNumericField T="int" @bind-Value="form.TopK" Label="Results" Min="1" Max="RagToolLimits.MaxTopK" Variant="Variant.Outlined"
                                         HelperText="Up to 20." />
                        <MudTextField @bind-Value="form.ScoreThreshold" Label="Score threshold" Variant="Variant.Outlined"
                                      HelperText="Optional. Scores depend on the model and the distance." />
                        <MudNumericField T="int" @bind-Value="form.MaxResultCharacters" Label="Result size (characters)"
                                         Min="RagToolLimits.MinMaxResultCharacters" Max="RagToolLimits.MaxMaxResultCharacters" Variant="Variant.Outlined"
                                         HelperText="Whole chunks only: never cut." />
                    </MudStack>

                    <MudText Typo="Typo.subtitle2">Search within documents</MudText>
                    var supportsDocumentIds = RagToolView.SupportsDocumentIds(form.KnowledgeBaseIds, _details);
                    <div data-document-ids>
                        <MudCheckBox T="bool" Value="form.AllowDocumentIds" ValueChanged="on => form.ChooseDocumentIds(on)" Dense="true"
                                     Disabled="@(supportsDocumentIds == false)"
                                     Label="Let the model restrict a search to given documents (document_ids)" />
                        <div class="tool-hint">
                            @if (supportsDocumentIds == false)
                            {
                                <span data-document-ids-unsupported>None of the selected knowledge bases maps the document id, so the model cannot be offered this. Map it in Knowledge.</span>
                            }
                            else if (supportsDocumentIds is null)
                            {
                                <span>A knowledge base shared with you does not show its mapping: the server refuses this if none of the knowledge bases maps the document id.</span>
                            }
                            else
                            {
                                <span>
                                    After a lookup tool lists documents, the model can search inside only those. It can name up to 50 at a time.
                                    Knowledge bases that do not map the document id are skipped, and the answer says so.
                                </span>
                            }
                        </div>
                    </div>
                }

                <label class="tool-policy">Policy
                    <select aria-label="Policy" @bind="form.Policy">
                        <option value="@ToolPolicies.Auto">Run without asking</option>
                        <option value="@ToolPolicies.Confirm">Ask before running</option>
                    </select>
                </label>

                <ScopePicker Form="form.Scope" Assistants="_assistants" Tenants="_tenants" Subject="tool"
                             GlobalWarning="Every tenant of this installation will see the tool. All its knowledge bases must be visible to every tenant too." />

                @if (form.KnowledgeBaseIds.Count > 0)
                {
                    <div class="tool-hint" data-parameters>
                        Parameters the model will get: <span class="tool-name">@string.Join(", ", RagToolView.ParameterNames(exposed, form.Aliases, form.KnowledgeBaseIds.Count))</span>
                        (the saved definition below is the real one).
                    </div>
                }

                @if (_formProblems.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <ul class="problem-list">
                            @foreach (var message in _formProblems)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <ProblemMessage Problem="_formProblem" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    @if (!form.IsNew)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="DeleteAsync" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                        <MudSpacer />
                    }

                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save</MudButton>
                </MudStack>

                @foreach (var warning in _formWarnings)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-warning="@warning.Code">@warning.Message</MudAlert>
                }

                @if (_definition is { } definition)
                {
                    <MudDivider />
                    <div data-definition>
                        <MudText Typo="Typo.subtitle2">Definition the model gets</MudText>
                        <div class="tool-hint">
                            <span class="tool-name">@definition.Name</span> · @RagToolView.SizeText(definition.EstimatedTokens)
                        </div>
                        <div class="tool-row-description">@definition.Description</div>
                        <details class="tool-detail" open>
                            <summary>Input schema</summary>
                            <pre class="tool-pre">@RagToolView.FormatSchema(definition.InputSchema)</pre>
                        </details>
                    </div>
                }
                else if (!form.IsNew)
                {
                    <div class="tool-hint">No knowledge base of this tool is visible, so it is not offered to any model.</div>
                }
            </MudStack>
        </form>
        </div>
    }
</ListDrawer>

@code {
    private static readonly IReadOnlyList<FilterOption> StatusOptions =
    [
        new(ToolStates.Enabled, "Enabled"),
        new(ToolStates.Disabled, "Disabled"),
        new(ToolStates.PendingReview, "To review"),
    ];

    private ListDrawer? _drawer;
    private ListScreen<RagToolListItem> _screen = null!;
    private List<KnowledgeBaseListItem> _bases = [];
    private IReadOnlyList<DictionaryField> _dictionary = [];
    private IReadOnlyList<AssistantSummary> _assistants = [];
    private IReadOnlyList<TenantSummary>? _tenants;
    private readonly Dictionary<Guid, KnowledgeBaseDetail> _details = [];
    private ApiProblem? _problem;
    private ApiProblem? _drawerProblem;
    private bool _busy;
    private int _rowGeneration;
    private string? _notice;
    private bool _lookupsLoaded;
    private string? _openedId;

    private RagToolForm? _form;
    private string _initial = string.Empty;
    private IReadOnlyList<string> _formProblems = [];
    private ApiProblem? _formProblem;
    private RagToolDefinition? _definition;
    private IReadOnlyList<ToolWarning> _formWarnings = [];

    /// <summary>The drawer: <c>new</c> or the id of the tool. Without it only the list shows.</summary>
    [Parameter]
    public string? Id { get; set; }

    private string DrawerTitle => _form is null ? "Rag tool" : _form.IsNew ? "Add rag tool" : $"Edit rag__{_form.OriginalName}";

    private bool IsDirty => _form is not null && !string.Equals(_initial, Snapshot(), StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        _screen = new ListScreen<RagToolListItem>(Navigation, "/tools/rag", (query, cursor) => Api.ListRagToolsPageAsync(query, ListScreen<RagToolListItem>.PageSize, cursor), () => InvokeAsync(StateHasChanged));

        var assistants = await Api.ListAssistantsAsync();
        _assistants = assistants.IsSuccess ? assistants.Value : [];
        var tenants = await Api.ListTenantsAsync();
        _tenants = tenants.IsSuccess ? tenants.Value : null;

        await _screen.ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_openedId == Id)
        {
            return;
        }

        _openedId = Id;
        _formProblems = [];
        _formProblem = null;
        _drawerProblem = null;
        _definition = null;
        _formWarnings = [];

        if (Id is null)
        {
            _form = null;
        }
        else if (Id == ListScreen<RagToolListItem>.NewId)
        {
            _form = null;
            if (await EnsureLookupsAsync())
            {
                _form = new RagToolForm();
                _initial = Snapshot();
            }
        }
        else if (Guid.TryParse(Id, out var id))
        {
            _form = null;
            var detail = await Api.GetRagToolAsync(id);
            if (!detail.IsSuccess)
            {
                _drawerProblem = detail.Problem;
            }
            else if (await EnsureLookupsAsync())
            {
                await OpenAsync(detail.Value);
            }
        }
        else
        {
            _form = null;
            _drawerProblem = new ApiProblem(404, "tool.not_found", "There is no such tool.", new Dictionary<string, string[]>());
        }
    }

    // The knowledge bases and the dictionary are read when the drawer first opens: the list does not need them.
    private async Task<bool> EnsureLookupsAsync()
    {
        if (_lookupsLoaded)
        {
            return true;
        }

        var bases = await Api.ListKnowledgeBasesAsync();
        if (!bases.IsSuccess)
        {
            _drawerProblem = bases.Problem;
            return false;
        }

        var dictionary = await Api.ListDictionaryAsync();
        if (!dictionary.IsSuccess)
        {
            _drawerProblem = dictionary.Problem;
            return false;
        }

        _bases = bases.Value;
        _dictionary = dictionary.Value;
        _lookupsLoaded = true;
        return true;
    }

    private string Snapshot() => JsonSerializer.Serialize(_form!.ToRequest(_dictionary));

    // The tool row lets the admin enable, disable and set the policy like for any other tool.
    private static ToolInfo AsToolInfo(RagToolListItem tool) => new(
        tool.Id,
        "Rag",
        null,
        tool.Name,
        tool.KnowledgeBases.Count > 0 ? $"Searches {string.Join(", ", tool.KnowledgeBases.Select(k => k.Name))}." : string.Empty,
        tool.State,
        tool.Policy,
        null);

    private async Task ChangeToolAsync((ToolInfo Tool, string State, string Policy) change)
    {
        await RunAsync(async () =>
        {
            var result = await Api.UpdateToolAsync(change.Tool.Id, change.State, change.Policy);
            if (!result.IsSuccess)
            {
                // The control already shows what the admin chose: draw the rows again from what the server has.
                _problem = result.Problem;
                _rowGeneration++;
            }

            await _screen.ReloadAsync();
        });
    }

    private async Task LoadDetailAsync(KnowledgeBaseListItem knowledgeBase)
    {
        if (knowledgeBase.Shared || _details.ContainsKey(knowledgeBase.Id))
        {
            return;
        }

        var detail = await Api.GetKnowledgeBaseAsync(knowledgeBase.Id);
        if (detail.IsSuccess)
        {
            _details[knowledgeBase.Id] = detail.Value;
        }
    }

    private async Task OpenAsync(RagToolDetail detail)
    {
        foreach (var knowledgeBase in _bases.Where(b => detail.KnowledgeBaseIds.Contains(b.Id)))
        {
            await LoadDetailAsync(knowledgeBase);
        }

        var mapped = RagToolView.Candidates(detail.KnowledgeBaseIds, _details, _dictionary);
        var form = RagToolForm.From(detail, _dictionary, mapped.Fields);
        form.KnowCandidates(mapped.Fields);
        _form = form;
        _initial = Snapshot();
        _definition = detail.Definition;
        _formWarnings = detail.Warnings;
        _formProblems = [];
        _formProblem = null;
    }

    private async Task ToggleKnowledgeBaseAsync(KnowledgeBaseListItem knowledgeBase, bool on)
    {
        var form = _form!;
        if (on)
        {
            if (!form.KnowledgeBaseIds.Contains(knowledgeBase.Id))
            {
                form.KnowledgeBaseIds.Add(knowledgeBase.Id);
            }

            await LoadDetailAsync(knowledgeBase);
        }
        else
        {
            form.KnowledgeBaseIds.Remove(knowledgeBase.Id);
        }

        var choices = RagToolView.Candidates(form.KnowledgeBaseIds, _details, _dictionary);
        form.ApplyCandidates(choices.Fields, exposeNew: choices.Complete);
        form.ApplyDocumentIds(RagToolView.SupportsDocumentIds(form.KnowledgeBaseIds, _details));
    }

    private void ToggleExposed(DictionaryField field, bool on)
    {
        if (on)
        {
            _form!.ExposedFieldIds.Add(field.Id);
        }
        else
        {
            _form!.ExposedFieldIds.Remove(field.Id);
        }
    }

    private void AddFixedFilter(string? value)
    {
        if (Guid.TryParse(value, out var id))
        {
            _form!.AddFixedFilter(id);
        }
    }

    private async Task SaveAsync()
    {
        var form = _form!;
        _formProblem = null;
        _formProblems = form.Problems(_dictionary);
        if (_formProblems.Count > 0)
        {
            return;
        }

        var request = form.ToRequest(_dictionary);
        await RunAsync(async () =>
        {
            Guid id;
            if (form.Id is { } existing)
            {
                var updated = await Api.UpdateRagToolAsync(existing, request);
                if (!updated.IsSuccess)
                {
                    _formProblem = updated.Problem;
                    return;
                }

                id = existing;
            }
            else
            {
                var created = await Api.CreateRagToolAsync(request);
                if (!created.IsSuccess)
                {
                    _formProblem = created.Problem;
                    return;
                }

                id = created.Value.Id;
            }

            // The drawer stays open on the saved tool, with the definition the model gets and what it takes of the context.
            var saved = await Api.GetRagToolAsync(id);
            if (saved.IsSuccess)
            {
                await OpenAsync(saved.Value);
                _notice = $"rag__{request.Name} was saved. Activate it on an assistant in Settings for a model to use it.";
                if (form.Id is null)
                {
                    _openedId = id.ToString();
                    _drawer?.SkipNextGuard();
                    Navigation.NavigateTo(_screen.DrawerUri(id.ToString()), replace: true);
                }
            }
            else
            {
                _problem = saved.Problem;
            }

            await _screen.ReloadAsync();
        });
    }

    private async Task DeleteAsync()
    {
        var form = _form!;
        if (!await Confirmations.ConfirmDeleteAsync(
                Dialogs,
                $"Delete rag__{form.OriginalName}?",
                "It is removed from every assistant. The audit log keeps its name.",
                "Delete tool"))
        {
            return;
        }

        await RunAsync(async () =>
        {
            var result = await Api.DeleteRagToolAsync(form.Id!.Value);
            if (!result.IsSuccess)
            {
                _formProblem = result.Problem;
                return;
            }

            _notice = $"rag__{form.OriginalName} was deleted.";
            _form = null;
            _drawer?.SkipNextGuard();
            _screen.CloseDrawer();
            await _screen.ReloadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _problem = null;
        _notice = null;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => _screen.Dispose();
}
