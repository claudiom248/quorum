@page "/tools/web-search"
@page "/tools/web-search/{Id}"
@implements IDisposable
@inject QuorumApi Api
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>Web search tools · Quorum</PageTitle>

<ListPage Title="Web search tools"
          Description="A web search tool lets an assistant ask the platform's SearXNG instance for what is newest or for what it does not know. The instance itself is set in Settings; here you decide how a search answers: how many results, which engines, in which language, and how often one conversation may ask. Activate a tool on an assistant in its settings."
          AddLabel="Add web search tool" OnAdd="() => _screen.OpenDrawer(ListScreen<WebSearchToolListItem>.NewId)" Notice="@_notice"
          Loading="_screen.Loading" Problem="_screen.Items.Count == 0 ? _screen.Problem : null" OnRetry="_screen.ReloadAsync"
          IsEmpty="_screen.IsEmpty" HasFilters="_screen.Query.HasFilters" OnClearFilters="() => _screen.ChangeQueryAsync(ListQuery.Empty)"
          EmptyTitle="No web search tool is configured yet" EmptyText="Add one to let an assistant search the web.">
    <FilterContent>
        <FilterBar Query="_screen.Query" QueryChanged="_screen.ChangeQueryAsync" Tenants="_tenants" Assistants="_assistants"
                   StatusOptions="StatusOptions" SearchPlaceholder="Search by name or description" />
    </FilterContent>
    <ChildContent>
        <ProblemMessage Problem="_screen.Items.Count > 0 ? _screen.Problem ?? _problem : _problem" />
        <MudTable T="WebSearchToolListItem" Items="_screen.Items" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="list-grid" data-grid="web-search">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Scope</MudTh>
                <MudTh>State</MudTh>
            </HeaderContent>
            <RowTemplate Context="tool">
                <MudTd DataLabel="Name">
                    <MudLink Href="@_screen.DrawerUri(tool.Id.ToString())" Class="tool-name" data-web-search-tool="@tool.Name">web_search__@tool.Name</MudLink>
                    <div class="tool-row-description">@tool.Description</div>
                </MudTd>
                <MudTd DataLabel="Scope"><ScopeBadge Scope="tool.Scope" Assistants="_assistants" Shared="tool.Shared" /></MudTd>
                <MudTd DataLabel="State">
                    <ToolStateCell @key="(tool.Id, _rowGeneration)" Tool="AsToolInfo(tool)" ReadOnly="tool.Shared" Busy="_busy" OnChange="ChangeToolAsync" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_screen.Cursor is not null)
        {
            <MudButton Variant="Variant.Outlined" Class="mt-3" Disabled="_screen.Loading" OnClick="_screen.LoadMoreAsync">Load more</MudButton>
        }
    </ChildContent>
</ListPage>

<ListDrawer @ref="_drawer" Open="Id is not null" Title="@DrawerTitle" Wide="true" Dirty="IsDirty" OnClose="_screen.CloseDrawer">
    @if (_form is null)
    {
        @if (_drawerProblem is not null)
        {
            <ProblemMessage Problem="_drawerProblem" />
        }
        else
        {
            <MudProgressLinear Indeterminate="true" />
        }
    }
    else
    {
        var form = _form;
        <div data-form="web-search">
            <form @onsubmit="SaveAsync">
                <MudStack Spacing="3">
                    @if (!_instanceIsSet)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            The platform has no search instance yet, so a tool saved now will be refused.
                            Set one in <MudLink Href="settings">Settings</MudLink> first.
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" Required="true" MaxLength="@WebSearchToolLimits.MaxNameLength"
                                  HelperText="Lower-case letters, digits, '-' and '_'. The model sees the tool as web_search__name." />
                    <MudTextField @bind-Value="form.Description" Label="Description" Variant="Variant.Outlined" Required="true" Lines="3"
                                  MaxLength="@WebSearchToolLimits.MaxDescriptionLength"
                                  HelperText="For the model: when to search the web instead of answering from what it knows or from a knowledge base." />

                    <MudNumericField T="int" @bind-Value="form.TopN" Label="Results per search" Variant="Variant.Outlined"
                                     Min="@WebSearchToolLimits.MinTopN" Max="@WebSearchToolLimits.MaxTopN" data-web-search-top-n
                                     HelperText="@($"From {WebSearchToolLimits.MinTopN} to {WebSearchToolLimits.MaxTopN}. Each one comes back with its title, address and a short extract.")" />
                    <MudNumericField T="int" @bind-Value="form.MaxInvocations" Label="Most calls per conversation" Variant="Variant.Outlined"
                                     Min="@WebSearchToolLimits.MinMaxInvocations" Max="@WebSearchToolLimits.MaxMaxInvocations" data-web-search-invocations
                                     HelperText="After that the model is told it stopped, so one question cannot spend the whole answer searching." />
                    <MudTextField @bind-Value="form.Language" Label="Language" Variant="Variant.Outlined" MaxLength="5"
                                  HelperText="A two-letter code, with an optional region: it, en, en-us. Leave it empty to let the instance decide." />
                    <MudTextField @bind-Value="form.EnginesText" Label="Engines" Variant="Variant.Outlined" Lines="3"
                                  HelperText="One per line, as the instance names them: google, bing, duckduckgo. Leave it empty to ask all the ones it enables." />

                    <label class="tool-policy">Safe search
                        <select aria-label="Safe search" @bind="form.SafeSearch">
                            <option value="0">Off</option>
                            <option value="1">Moderate</option>
                            <option value="2">Strict</option>
                        </select>
                    </label>
                    <label class="tool-policy">Only results from
                        <select aria-label="Time range" @bind="form.TimeRange">
                            <option value="">Any time</option>
                            @foreach (var (value, label) in WebSearchToolLimits.TimeRanges)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </label>
                    <label class="tool-policy">Policy
                        <select aria-label="Policy" @bind="form.Policy">
                            <option value="@ToolPolicies.Auto">Run without asking</option>
                            <option value="@ToolPolicies.Confirm">Ask before running</option>
                        </select>
                    </label>

                    <ScopePicker Form="form.Scope" Assistants="_assistants" Tenants="_tenants" Subject="tool"
                                 GlobalWarning="Every tenant of this installation will see the tool and may search the web through it." />

                    @if (_formProblems.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <ul class="problem-list">
                                @foreach (var message in _formProblems)
                                {
                                    <li>@message</li>
                                }
                            </ul>
                        </MudAlert>
                    }

                    <ProblemMessage Problem="_formProblem" />

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        @if (!form.IsNew)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="DeleteAsync" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                            <MudSpacer />
                        }

                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                                   data-save-web-search-tool>Save</MudButton>
                    </MudStack>

                    @if (_definition is not null)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">Definition the model gets</MudText>
                        <div data-definition="@_definition.Name">
                            <div class="tool-hint">
                                <span class="tool-name">@_definition.Name</span> · @RagToolView.SizeText(_definition.EstimatedTokens)
                            </div>
                            <div class="tool-row-description">@_definition.Description</div>
                            <details class="tool-detail">
                                <summary>Input schema</summary>
                                <pre class="tool-pre">@RagToolView.FormatSchema(_definition.InputSchema)</pre>
                            </details>
                        </div>
                    }
                </MudStack>
            </form>
        </div>
    }
</ListDrawer>

@code {
    private static readonly IReadOnlyList<FilterOption> StatusOptions =
    [
        new(ToolStates.Enabled, "Enabled"),
        new(ToolStates.Disabled, "Disabled"),
        new(ToolStates.PendingReview, "To review"),
    ];

    private ListDrawer? _drawer;
    private ListScreen<WebSearchToolListItem> _screen = null!;
    private IReadOnlyList<AssistantSummary> _assistants = [];
    private IReadOnlyList<TenantSummary>? _tenants;
    private bool _instanceIsSet;
    private ApiProblem? _problem;
    private ApiProblem? _drawerProblem;
    private ApiProblem? _formProblem;
    private IReadOnlyList<string> _formProblems = [];
    private bool _busy;
    private int _rowGeneration;
    private string? _notice;
    private WebSearchToolForm? _form;
    private string _initial = string.Empty;
    private WebSearchToolDefinition? _definition;
    private string? _openedId;

    /// <summary>The drawer: <c>new</c> or the id of the tool. Without it only the list shows.</summary>
    [Parameter]
    public string? Id { get; set; }

    private string DrawerTitle => _form is null ? "Web search tool" : _form.IsNew ? "Add web search tool" : $"Edit web_search__{_form.OriginalName}";

    private bool IsDirty => _form is not null && !string.Equals(_initial, Snapshot(), StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        _screen = new ListScreen<WebSearchToolListItem>(
            Navigation,
            "/tools/web-search",
            (query, cursor) => Api.ListWebSearchToolsPageAsync(query, ListScreen<WebSearchToolListItem>.PageSize, cursor),
            () => InvokeAsync(StateHasChanged));

        var assistants = await Api.ListAssistantsAsync();
        _assistants = assistants.IsSuccess ? assistants.Value : [];
        var tenants = await Api.ListTenantsAsync();
        _tenants = tenants.IsSuccess ? tenants.Value : null;

        // What the drawer has to warn about before anything is typed: a tool without an instance cannot be saved.
        var instance = await Api.GetWebSearchConfigurationAsync();
        _instanceIsSet = instance.IsSuccess && !string.IsNullOrWhiteSpace(instance.Value.Url);

        await _screen.ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_openedId == Id)
        {
            return;
        }

        _openedId = Id;
        _formProblems = [];
        _formProblem = null;
        _drawerProblem = null;
        _definition = null;

        if (Id is null)
        {
            _form = null;
        }
        else if (Id == ListScreen<WebSearchToolListItem>.NewId)
        {
            _form = new WebSearchToolForm();
            _initial = Snapshot();
        }
        else if (Guid.TryParse(Id, out var id))
        {
            _form = null;
            var detail = await Api.GetWebSearchToolAsync(id);
            if (!detail.IsSuccess)
            {
                _drawerProblem = detail.Problem;
            }
            else
            {
                Open(detail.Value);
            }
        }
        else
        {
            _form = null;
            _drawerProblem = new ApiProblem(404, "web_search.not_found", "There is no such tool.", new Dictionary<string, string[]>());
        }
    }

    private void Open(WebSearchToolDetail detail)
    {
        _form = WebSearchToolForm.From(detail);
        _definition = detail.Definition;
        _initial = Snapshot();
    }

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(_form!.ToRequest());

    // The tool row lets the admin enable, disable and set the policy like for any other tool.
    private static ToolInfo AsToolInfo(WebSearchToolListItem tool) => new(
        tool.Id,
        "WebSearch",
        null,
        tool.Name,
        tool.Description,
        tool.State,
        tool.Policy,
        null);

    private async Task ChangeToolAsync((ToolInfo Tool, string State, string Policy) change)
    {
        await RunAsync(async () =>
        {
            var result = await Api.UpdateToolAsync(change.Tool.Id, change.State, change.Policy);
            if (!result.IsSuccess)
            {
                // The control already shows what the admin chose: draw the rows again from what the server has.
                _problem = result.Problem;
                _rowGeneration++;
            }

            await _screen.ReloadAsync();
        });
    }

    private async Task SaveAsync()
    {
        var form = _form!;
        _formProblem = null;
        _formProblems = form.Problems();
        if (_formProblems.Count > 0)
        {
            return;
        }

        var request = form.ToRequest();

        await RunAsync(async () =>
        {
            Guid id;
            if (form.Id is { } existing)
            {
                var updated = await Api.UpdateWebSearchToolAsync(existing, request);
                if (!updated.IsSuccess)
                {
                    _formProblem = updated.Problem;
                    return;
                }

                id = existing;
            }
            else
            {
                var created = await Api.CreateWebSearchToolAsync(request);
                if (!created.IsSuccess)
                {
                    _formProblem = created.Problem;
                    return;
                }

                id = created.Value.Id;
            }

            // The drawer stays open on the saved tool, with the definition the model gets.
            var saved = await Api.GetWebSearchToolAsync(id);
            if (saved.IsSuccess)
            {
                Open(saved.Value);
                _notice = $"web_search__{request.Name} was saved. Activate it on an assistant in Settings for a model to use it.";
                if (form.Id is null)
                {
                    _openedId = id.ToString();
                    _drawer?.SkipNextGuard();
                    Navigation.NavigateTo(_screen.DrawerUri(id.ToString()), replace: true);
                }
            }
            else
            {
                _problem = saved.Problem;
            }

            await _screen.ReloadAsync();
        });
    }

    private async Task DeleteAsync()
    {
        var form = _form!;
        if (!await Confirmations.ConfirmDeleteAsync(
                Dialogs,
                $"Delete web_search__{form.OriginalName}?",
                "It is removed from every assistant. The audit log keeps its name.",
                "Delete tool"))
        {
            return;
        }

        await RunAsync(async () =>
        {
            var result = await Api.DeleteWebSearchToolAsync(form.Id!.Value);
            if (!result.IsSuccess)
            {
                _formProblem = result.Problem;
                return;
            }

            _notice = $"web_search__{form.OriginalName} was deleted.";
            _form = null;
            _definition = null;
            _drawer?.SkipNextGuard();
            _screen.CloseDrawer();
            await _screen.ReloadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _problem = null;
        _notice = null;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => _screen.Dispose();
}
