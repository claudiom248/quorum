@page "/setup"
@layout CenteredLayout
@inject QuorumApi Api
@inject Session Session
@inject NavigationManager Navigation

<PageTitle>Set up Quorum</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_status is not null)
{
    <MudText Typo="Typo.h5">Set up Quorum</MudText>
    <MudText Typo="Typo.caption" Class="mb-4" Style="display:block">Step @_step of 2</MudText>
    <MudProgressLinear Value="@(_step * 100 / 2)" Class="mb-4" />

    @if (_step == 1)
    {
        <MudText Class="mb-3">Paste the setup token printed in the application logs (<code>docker compose logs quorum</code>), then create the administrator.</MudText>
        <form @onsubmit="VerifyTokenAsync">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_token" Label="Setup token" InputType="InputType.Password" Variant="Variant.Outlined"
                              Required="true" AutoFocus="true" autocomplete="off" />
                <MudTextField @bind-Value="_displayName" Label="Your name" Variant="Variant.Outlined" Required="true" autocomplete="name" />
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined"
                              Required="true" autocomplete="username" />
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"
                              Required="true" HelperText="At least 12 characters." autocomplete="new-password" />
                <ProblemMessage Problem="_problem" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Continue</MudButton>
            </MudStack>
        </form>
    }
    else
    {
        <MudText Class="mb-3">Connect Quorum to an OpenAI-compatible model endpoint, such as Ollama. The default system prompt applies; you can change it later in the settings.</MudText>
        <form @onsubmit="CompleteAsync">
            <MudStack Spacing="3">
                <ModelConnectionForm Value="_model" Busy="_busy" Test="TestModelAsync" />
                <ProblemMessage Problem="_problem" />
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton OnClick="@(() => _step = 1)">Back</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Finish setup</MudButton>
                </MudStack>
            </MudStack>
        </form>
    }
}
else
{
    <ProblemMessage Problem="_problem" />
}

@code {
    private const int MinPasswordLength = 12;

    private SetupStatus? _status;
    private bool _loading = true;
    private bool _busy;
    private int _step = 1;
    private ApiProblem? _problem;
    private bool _modelReached;

    private readonly ModelConnectionFields _model = new() { BaseUrl = "http://localhost:11434/v1" };
    private string _token = string.Empty;
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetSetupStatusAsync();
        _loading = false;
        if (!result.IsSuccess)
        {
            _problem = result.Problem;
            return;
        }

        if (!result.Value.IsSetupMode)
        {
            Navigation.NavigateTo(string.Empty, replace: true);
            return;
        }

        _status = result.Value;
        _model.ContextTokenBudget = result.Value.DefaultContextTokenBudget ?? _model.ContextTokenBudget;
    }

    private async Task VerifyTokenAsync()
    {
        // The admin fields are on this step: a mistake in them is told here, not by the server after the model step.
        var mistakes = new List<string>();
        if (string.IsNullOrWhiteSpace(_displayName))
        {
            mistakes.Add("Enter your name.");
        }

        if (!_email.Contains('@', StringComparison.Ordinal))
        {
            mistakes.Add("Enter a valid email.");
        }

        if (_password.Length < MinPasswordLength)
        {
            mistakes.Add($"The password needs at least {MinPasswordLength} characters.");
        }

        if (mistakes.Count > 0)
        {
            _problem = new ApiProblem(400, "setup.invalid_admin", mistakes[0], new Dictionary<string, string[]> { ["admin"] = [.. mistakes] });
            return;
        }

        _busy = true;
        _problem = null;
        var result = await Api.VerifySetupTokenAsync(_token.Trim());
        _busy = false;

        if (result.IsSuccess)
        {
            _step = 2;
        }
        else
        {
            _problem = result.Problem;
        }
    }

    private async Task<ApiResult<ModelConnection>> TestModelAsync(string baseUrl, string? key, string? model)
    {
        var result = await Api.TestSetupModelAsync(_token.Trim(), baseUrl, key, model);
        _modelReached = result.IsSuccess;
        return result;
    }

    private async Task CompleteAsync()
    {
        _busy = true;
        _problem = null;

        // No system prompt is sent: the server applies the default one.
        var request = new CompleteSetupRequest(
            new AdminAccount(_email.Trim(), _displayName.Trim(), _password),
            new ModelEndpointSettings(_model.BaseUrl.Trim(), _model.ModelName.Trim(), EmptyToNull(_model.ApiKey), _model.ContextTokenBudget, _model.SupportsTools));
        var result = await Api.CompleteSetupAsync(_token.Trim(), request);
        _busy = false;

        if (!result.IsSuccess)
        {
            _problem = result.Problem;
            return;
        }

        Session.Reset();

        // An unreachable model does not block the setup (it may still be starting): the settings page warns about it.
        Navigation.NavigateTo(_modelReached ? string.Empty : "settings?unverified=1", forceLoad: true);
    }

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
