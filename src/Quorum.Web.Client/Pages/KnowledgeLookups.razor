@page "/knowledge/lookups"
@inject QuorumApi Api

<PageTitle>Lookups · Quorum</PageTitle>

<div class="settings tools-admin">
    <MudText Typo="Typo.h5" Class="mb-1">Knowledge</MudText>
    <KnowledgeNav Current="lookups" />
    <MudText Typo="Typo.body2" Class="tools-support-hint mb-4">
        Lookups are lists of values that models read to know what exists: the suppliers, the departments, the audiences. Quorum computes them
        in the background from the knowledge bases (choose the fields in the registration of each) and keeps them in its own database; you can
        also type a list by hand. A lookup tool, configured in Tools, hands them to an assistant.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_loadProblem is not null)
    {
        <ProblemMessage Problem="_loadProblem" />
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync">Try again</MudButton>
    }
    else
    {
        @if (_notice is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3" role="status">@_notice</MudAlert>
        }

        <ProblemMessage Problem="_problem" />

        <MudText Typo="Typo.subtitle1" Class="mt-2 mb-1">Computed from knowledge bases</MudText>
        @foreach (var group in _groups)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3 lookup-kb" data-lookup-kb="@group.KnowledgeBase.Name">
                <div class="tool-row-head">
                    <span class="tool-name">@group.KnowledgeBase.Name</span>
                    @if (group.Lookups.Count > 0)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="() => RefreshKnowledgeBaseAsync(group.KnowledgeBase)"
                                   StartIcon="@Icons.Material.Filled.Refresh">Refresh now</MudButton>
                    }
                </div>
                @if (group.Problem is not null)
                {
                    <ProblemMessage Problem="group.Problem" />
                }
                else if (group.Lookups.Count == 0)
                {
                    <div class="tool-hint">
                        No lookup yet. Mark the fields to list, or the name of the entities, in the lookups step of the registration (Edit).
                    </div>
                }

                @foreach (var lookup in group.Lookups)
                {
                    <div class="lookup-row" data-lookup="@lookup.Name">
                        <div class="tool-row-head">
                            <span class="tool-name">@lookup.Name</span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@LookupAdminView.KindLabel(lookup.Kind)</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Counts @LookupAdminView.UnitLabel(lookup.Unit)</MudChip>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_busy" OnClick="() => RefreshLookupAsync(lookup)">Refresh</MudButton>
                        </div>

                        @foreach (var slice in lookup.Slices)
                        {
                            <div class="lookup-slice" data-slice="@slice.Hash">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@(slice.Running ? Color.Info : LookupAdminView.NeedsAttention(slice) ? Color.Warning : slice.Status == LookupStatuses.Ready ? Color.Success : Color.Default)">@LookupAdminView.StatusLabel(slice)</MudChip>
                                <span class="tool-hint">
                                    @LookupAdminView.SliceLabel(slice) · @LookupAdminView.ValueCountLabel(slice) ·
                                    computed @LookupAdminView.When(slice.ComputedAt)
                                    @if (slice.NextRefreshAt is { } next)
                                    {
                                        <span> · next @LookupAdminView.When(next)</span>
                                    }
                                </span>
                                @if (slice.ValueCount > 0 || slice.Status == LookupStatuses.Ready)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => ShowValues(lookup.Id, slice.Hash)">Values</MudButton>
                                }
                                @if (!string.IsNullOrWhiteSpace(slice.Error))
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-1" data-lookup-error>
                                        The last computation failed@(slice.Stale ? "; models still read the last good list" : string.Empty): @slice.Error
                                    </MudAlert>
                                }
                            </div>
                            @if (_viewing is { } viewing && viewing.LookupId == lookup.Id && viewing.Slice == slice.Hash)
                            {
                                <LookupValues @key="viewing" LookupId="lookup.Id" Slice="@slice.Hash" Counted="@(lookup.Unit is not null)" Entity="@(lookup.Kind == LookupKinds.Entity)" OnClose="() => _viewing = null" />
                            }
                        }
                    </div>
                }
            </MudPaper>
        }

        @if (_groups.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="tools-support-hint mb-3">No knowledge base of this tenant is registered yet.</MudText>
        }

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">Typed by hand</MudText>
        <MudText Typo="Typo.body2" Class="tools-support-hint mb-2">
            For a list the collection cannot give: nationalities, audiences, the departments of the company. Up to @LookupLimits.MaxManualValues values.
        </MudText>

        @foreach (var lookup in _manual)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3 manual-lookup" data-manual="@lookup.Name">
                <div class="tool-row-head">
                    <span class="tool-name">@lookup.Name</span>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@lookup.ValueCount values</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@LookupAdminView.ScopeLabel(lookup)</MudChip>
                    @if (lookup.Shared)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Shared with you</MudChip>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(lookup.Description))
                {
                    <div class="tool-row-description">@lookup.Description</div>
                }

                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="() => ShowValues(lookup.Id, slice: null)">Values</MudButton>
                    @if (!lookup.Shared)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="() => EditAsync(lookup)"
                                   StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Disabled="_busy"
                                   OnClick="() => _deleting = lookup.Id" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                    }
                </MudStack>

                @if (_deleting == lookup.Id)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                        Delete @lookup.Name and its values? A lookup tool that uses it must drop it first.
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Disabled="_busy"
                                       OnClick="() => DeleteAsync(lookup)">Delete lookup</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _deleting = null">Cancel</MudButton>
                        </MudStack>
                    </MudAlert>
                }

                @if (_viewing is { } viewing && viewing.LookupId == lookup.Id && viewing.Slice is null)
                {
                    <LookupValues @key="viewing" LookupId="lookup.Id" Counted="false" OnClose="() => _viewing = null" />
                }
            </MudPaper>
        }

        @if (_manual.Count == 0 && _form is null)
        {
            <MudText Typo="Typo.body2" Class="tools-support-hint mb-3">No lookup was typed yet.</MudText>
        }

        @if (_form is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartNew" StartIcon="@Icons.Material.Filled.Add">New manual lookup</MudButton>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-4 mb-3" data-form="manual-lookup">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@(_form.IsNew ? "New manual lookup" : $"Edit {_form.Name}")</MudText>
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined" Required="true" MaxLength="@LookupLimits.MaxNameLength" Immediate="true"
                                  HelperText="Lower-case letters, digits and '_'. The model sees it, and a lookup tool needs it to be different from the other lookups it uses." />
                    <MudTextField @bind-Value="_form.Description" Label="Description" Variant="Variant.Outlined" Lines="2" MaxLength="@LookupLimits.MaxDescriptionLength"
                                  HelperText="What the list is. The model reads this to choose which list to ask for." />
                    <label class="tool-policy">Who can use it
                        <select aria-label="Scope" @bind="_form.Scope">
                            <option value="@ScopeKinds.Tenant">This tenant</option>
                            <option value="@ScopeKinds.Global">Every tenant</option>
                        </select>
                    </label>
                    @if (_form.Scope == ScopeKinds.Tenant)
                    {
                        <MudTextField @bind-Value="_form.TenantsText" Label="Other tenants (ids, optional)" Variant="Variant.Outlined" Lines="2"
                                      HelperText="Tenants that may use the lookup besides this one, read-only." />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Every tenant of this installation will be able to read these values.</MudAlert>
                    }

                    <MudTextField @bind-Value="_form.ValuesText" Label="Values" Variant="Variant.Outlined" Lines="10" Immediate="true" Class="schema-input" aria-label="Values"
                                  HelperText="One per line, pasted or typed: value | label | synonym; synonym. The label and the synonyms are optional; the order is kept." />
                    <div>
                        <label class="tool-policy">Add from a CSV file
                            <InputFile OnChange="ImportAsync" accept=".csv,text/csv,text/plain" aria-label="CSV file" />
                        </label>
                        <div class="tool-hint">
                            Columns: value, label, synonyms (separated by ";" or "|"). A first row reading "value" is skipped. The values are added to the list above for you to check.
                        </div>
                        @if (_imported is not null)
                        {
                            <div class="tool-hint" role="status" data-imported>@_imported</div>
                        }
                    </div>

                    @if (_showFormProblems && _form.Problems() is { Count: > 0 } problems)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <ul class="problem-list">
                                @foreach (var message in problems.Take(10))
                                {
                                    <li>@message</li>
                                }
                                @if (problems.Count > 10)
                                {
                                    <li>and @(problems.Count - 10) more.</li>
                                }
                            </ul>
                        </MudAlert>
                    }

                    <ProblemMessage Problem="_formProblem" />

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="CancelForm" Disabled="_busy">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">@(_form.IsNew ? "Create" : "Save changes")</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    }
</div>

@code {
    private const long MaxImportBytes = 2 * 1024 * 1024;

    private sealed record Group(KnowledgeBaseListItem KnowledgeBase, IReadOnlyList<KnowledgeBaseLookupInfo> Lookups, ApiProblem? Problem);

    private sealed record Viewing(Guid LookupId, string? Slice);

    private List<Group> _groups = [];
    private List<ManualLookupInfo> _manual = [];
    private ApiProblem? _loadProblem;
    private ApiProblem? _problem;
    private ApiProblem? _formProblem;
    private bool _loading = true;
    private bool _loaded;
    private bool _busy;
    private string? _notice;
    private string? _imported;
    private Guid? _deleting;
    private Viewing? _viewing;
    private ManualLookupForm? _form;
    private bool _showFormProblems;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loadProblem = null;

        var bases = await Api.ListKnowledgeBasesAsync();
        if (!bases.IsSuccess)
        {
            FailLoad(bases.Problem!);
            return;
        }

        var manual = await Api.ListManualLookupsAsync();
        if (!manual.IsSuccess)
        {
            FailLoad(manual.Problem!);
            return;
        }

        var groups = new List<Group>();
        foreach (var knowledgeBase in bases.Value.Where(k => !k.Shared).OrderBy(k => k.Name, StringComparer.Ordinal))
        {
            var lookups = await Api.ListKnowledgeBaseLookupsAsync(knowledgeBase.Id);
            groups.Add(new Group(knowledgeBase, lookups.IsSuccess ? lookups.Value : [], lookups.IsSuccess ? null : lookups.Problem));
        }

        _groups = groups;
        _manual = manual.Value;
        _loaded = true;
    }

    // Before anything was loaded the problem replaces the page; afterwards the data on screen stays, with the problem next to it.
    private void FailLoad(ApiProblem problem)
    {
        if (_loaded)
        {
            _problem = problem;
        }
        else
        {
            _loadProblem = problem;
        }
    }

    private void ShowValues(Guid lookupId, string? slice) => _viewing = new Viewing(lookupId, slice);

    private async Task RefreshKnowledgeBaseAsync(KnowledgeBaseListItem knowledgeBase)
    {
        await RunAsync(async () =>
        {
            var result = await Api.RefreshKnowledgeBaseLookupsAsync(knowledgeBase.Id);
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _notice = $"The lookups of {knowledgeBase.Name} will be computed again within a minute. Reload to see how far it is.";
            await LoadAsync();
        });
    }

    private async Task RefreshLookupAsync(KnowledgeBaseLookupInfo lookup)
    {
        await RunAsync(async () =>
        {
            var result = await Api.RefreshLookupAsync(lookup.Id);
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _notice = $"{lookup.Name} will be computed again within a minute. Reload to see how far it is.";
            await LoadAsync();
        });
    }

    private void StartNew()
    {
        ClearMessages();
        _form = new ManualLookupForm();
    }

    private void CancelForm()
    {
        _form = null;
        _formProblem = null;
        _showFormProblems = false;
        _imported = null;
    }

    private async Task EditAsync(ManualLookupInfo lookup)
    {
        await RunAsync(async () =>
        {
            // The values come in pages of at most 200, in the order they were typed.
            var values = new List<LookupValueInfo>();
            string? cursor = null;
            do
            {
                var page = await Api.ReadLookupValuesAsync(lookup.Id, limit: 200, cursor: cursor);
                if (!page.IsSuccess)
                {
                    _problem = page.Problem;
                    return;
                }

                values.AddRange(page.Value.Values);
                cursor = page.Value.Cursor;
            }
            while (cursor is not null);

            _form = ManualLookupForm.From(lookup, values);
            _formProblem = null;
            _showFormProblems = false;
            _imported = null;
        });
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        _imported = null;
        if (_form is null || e.FileCount == 0)
        {
            return;
        }

        try
        {
            await using var stream = e.File.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream);
            var added = _form.ImportCsv(await reader.ReadToEndAsync());
            _imported = added == 0 ? "The file has no value." : $"{added} value(s) added from {e.File.Name}.";
        }
        catch (IOException)
        {
            _imported = $"The file could not be read; it can have up to {MaxImportBytes / 1024 / 1024} MB.";
        }
    }

    private async Task SaveAsync()
    {
        _showFormProblems = true;
        _formProblem = null;
        if (_form is null || _form.Problems().Count > 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var request = _form.ToRequest();
            var name = request.Name;
            var result = _form.Id is { } id
                ? await Api.UpdateManualLookupAsync(id, request)
                : (ApiResult)await Api.CreateManualLookupAsync(request);
            if (!result.IsSuccess)
            {
                _formProblem = result.Problem;
                return;
            }

            _notice = $"{name} was saved.";
            CancelForm();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ManualLookupInfo lookup)
    {
        await RunAsync(async () =>
        {
            var result = await Api.DeleteManualLookupAsync(lookup.Id);
            _deleting = null;
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _notice = $"{lookup.Name} was deleted.";
            await LoadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        ClearMessages(keepForm: true);
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearMessages(bool keepForm = false)
    {
        _problem = null;
        _notice = null;
        _deleting = null;
        if (!keepForm)
        {
            CancelForm();
        }
    }
}
