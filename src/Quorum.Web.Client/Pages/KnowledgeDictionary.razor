@page "/knowledge/dictionary"
@inject QuorumApi Api

<PageTitle>Dictionary · Quorum</PageTitle>

<div class="settings tools-admin">
    <MudText Typo="Typo.h5" Class="mb-1">Knowledge</MudText>
    <KnowledgeNav Current="dictionary" />
    <MudText Typo="Typo.body2" Class="tools-support-hint mb-4">
        The metadata dictionary: typed fields defined once and reused by knowledge bases and rag tools. Models filter on them.
        A name and a type cannot change once the field exists; the description can. A field in use cannot be deleted.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_loadProblem is not null)
    {
        <ProblemMessage Problem="_loadProblem" />
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync">Try again</MudButton>
    }
    else
    {
        @if (_notice is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3" role="status">@_notice</MudAlert>
        }

        <ProblemMessage Problem="_problem" />

        @if (_fields.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="tools-support-hint mb-3">The dictionary is empty. Fields are added here, or while registering a knowledge base.</MudText>
        }

        @foreach (var (cluster, group) in KnowledgeAdminView.GroupByCluster(_fields))
        {
            @if (cluster is not null)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1" data-cluster="@cluster">@cluster</MudText>
            }

            @foreach (var field in group)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3 dictionary-field" data-field="@field.Name">
                <div class="tool-row-head">
                    <span class="tool-name">@KnowledgeAdminView.FieldLabel(field, _fields)</span>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@KnowledgeAdminView.TypeLabel(field.Type)</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@KnowledgeAdminView.DictionaryScopeLabel(field.Scope.Kind)</MudChip>
                    @if (field.Shared)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Shared with you</MudChip>
                    }
                    <span class="tool-hint">Used by @field.UsedByCount</span>
                </div>

                @if (_editing == field.Id)
                {
                    <form @onsubmit="() => SaveDescriptionAsync(field)" class="mt-2">
                        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" MaxLength="500" Lines="2"
                                      HelperText="The model reads it to know what to filter on." />
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy">Save</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _editing = null">Cancel</MudButton>
                        </MudStack>
                    </form>
                }
                else
                {
                    <div class="tool-row-description">@(string.IsNullOrWhiteSpace(field.Description) ? "No description." : field.Description)</div>
                    @if (!field.Shared)
                    {
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="() => Edit(field)"
                                   StartIcon="@Icons.Material.Filled.Edit">Edit description</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Disabled="_busy"
                                   OnClick="() => _deleting = field.Id" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                    </MudStack>
                    }
                }

                @if (_deleting == field.Id)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                        Delete the field @field.Name? Models can no longer filter on it.
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Disabled="_busy"
                                       OnClick="() => DeleteAsync(field)">Delete field</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _deleting = null">Cancel</MudButton>
                        </MudStack>
                    </MudAlert>
                }
            </MudPaper>
        }
        }

        @if (_form is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartNew" StartIcon="@Icons.Material.Filled.Add">Add field</MudButton>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-4 mb-3" data-form="field">
                <form @onsubmit="CreateAsync">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.subtitle1">Add field</MudText>
                        <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined" Required="true" MaxLength="40"
                                      HelperText="Lower-case letters, digits and '_', starting with a letter. Not 'query' or 'knowledge_base', and not ending in _min, _max, _from or _to." />
                        <MudTextField @bind-Value="_form.Cluster" Label="Cluster" Variant="Variant.Outlined" MaxLength="40"
                                      HelperText="Optional. Groups related fields, such as hr or finance; with the name it identifies the field. Leave it empty for none." />
                        @if (ExistingClusters.Count > 0)
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <span class="tool-hint">Existing:</span>
                                @foreach (var existing in ExistingClusters)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => _form.Cluster = existing">@existing</MudChip>
                                }
                            </MudStack>
                        }
                        <label class="tool-policy">Type
                            <select aria-label="Type" @bind="_form.Type">
                                @foreach (var type in DictionaryFieldTypes.All)
                                {
                                    <option value="@type">@KnowledgeAdminView.TypeLabel(type)</option>
                                }
                            </select>
                        </label>
                        <label class="tool-policy">Who can use it
                            <select aria-label="Scope" @bind="_form.Scope">
                                <option value="@ScopeKinds.Tenant">This tenant</option>
                                <option value="@ScopeKinds.Global">Every tenant</option>
                            </select>
                        </label>
                        <MudTextField @bind-Value="_form.Description" Label="Description" Variant="Variant.Outlined" MaxLength="500" Lines="2"
                                      HelperText="Optional. The model reads it to know what to filter on." />
                        <ProblemMessage Problem="_formProblem" />
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelForm" Disabled="_busy">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save</MudButton>
                        </MudStack>
                    </MudStack>
                </form>
            </MudPaper>
        }
    }
</div>

@code {
    private List<DictionaryField> _fields = [];
    private ApiProblem? _loadProblem;
    private ApiProblem? _problem;
    private ApiProblem? _formProblem;
    private bool _loading = true;
    private bool _loaded;
    private bool _busy;
    private string? _notice;
    private Guid? _editing;
    private Guid? _deleting;
    private string _description = string.Empty;
    private NewField? _form;

    private List<string> ExistingClusters => [.. _fields.Select(f => f.Cluster).OfType<string>().Distinct().Order(StringComparer.Ordinal)];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loadProblem = null;
        var result = await Api.ListDictionaryAsync();
        if (result.IsSuccess)
        {
            _fields = result.Value;
            _loaded = true;
        }
        else if (_loaded)
        {
            _problem = result.Problem;
        }
        else
        {
            _loadProblem = result.Problem;
        }
    }

    private void StartNew()
    {
        ClearMessages();
        _form = new NewField();
    }

    private void CancelForm()
    {
        _form = null;
        _formProblem = null;
    }

    private void Edit(DictionaryField field)
    {
        ClearMessages();
        _editing = field.Id;
        _description = field.Description ?? string.Empty;
    }

    private async Task CreateAsync()
    {
        var form = _form!;
        await RunAsync(async () =>
        {
            var result = await Api.CreateDictionaryFieldAsync(new DictionaryFieldRequest(
                form.Name.Trim(),
                form.Type,
                string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim(),
                form.Scope,
                string.IsNullOrWhiteSpace(form.Cluster) ? null : form.Cluster.Trim()));
            if (!result.IsSuccess)
            {
                _formProblem = result.Problem;
                return;
            }

            _notice = $"The field {form.Name.Trim()} was added.";
            CancelForm();
            await LoadAsync();
        });
    }

    private async Task SaveDescriptionAsync(DictionaryField field)
    {
        await RunAsync(async () =>
        {
            var result = await Api.UpdateDictionaryFieldAsync(field.Id, string.IsNullOrWhiteSpace(_description) ? null : _description.Trim());
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _editing = null;
            _notice = $"The description of {field.Name} was saved.";
            await LoadAsync();
        });
    }

    private async Task DeleteAsync(DictionaryField field)
    {
        await RunAsync(async () =>
        {
            var result = await Api.DeleteDictionaryFieldAsync(field.Id);
            _deleting = null;
            if (!result.IsSuccess)
            {
                // A field in use answers 409 and names the knowledge bases and tools that use it.
                _problem = result.Problem;
                return;
            }

            _notice = $"The field {field.Name} was deleted.";
            await LoadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        ClearMessages(keepForm: true);
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearMessages(bool keepForm = false)
    {
        _problem = null;
        _notice = null;
        _editing = null;
        _deleting = null;
        if (!keepForm)
        {
            CancelForm();
        }
    }

    private sealed class NewField
    {
        public string Name { get; set; } = string.Empty;

        public string Cluster { get; set; } = string.Empty;

        public string Type { get; set; } = DictionaryFieldTypes.Text;

        public string Scope { get; set; } = ScopeKinds.Tenant;

        public string Description { get; set; } = string.Empty;
    }
}
