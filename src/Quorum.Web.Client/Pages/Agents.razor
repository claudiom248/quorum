@page "/agents"
@page "/agents/{Id}"
@implements IDisposable
@inject QuorumApi Api
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject OnboardingProgress Onboarding

<PageTitle>Agents · Quorum</PageTitle>

<ListPage Title="Agents"
          Description="An agent is a prompt, a model endpoint and tools. It can call other agents as tools, and be offered as an assistant that people chat with."
          AddLabel="Add agent" OnAdd="() => _screen.OpenDrawer(ListScreen<AgentListItem>.NewId)" Notice="@_notice"
          Loading="_screen.Loading" Problem="_screen.Items.Count == 0 ? _screen.Problem : null" OnRetry="_screen.ReloadAsync"
          IsEmpty="_screen.IsEmpty" HasFilters="_screen.Query.HasFilters" OnClearFilters="() => _screen.ChangeQueryAsync(ListQuery.Empty)"
          EmptyTitle="No agent yet" EmptyText="Add an agent to give an assistant something to answer through.">
    <FilterContent>
        <FilterBar Query="_screen.Query" QueryChanged="_screen.ChangeQueryAsync" ScopeOptions="ScopeOptions" Assistants="_assistantSummaries"
                   TypeLabel="Endpoint" TypeOptions="EndpointOptions" SearchPlaceholder="Search by name or slug" />
    </FilterContent>
    <ChildContent>
        <ProblemMessage Problem="_screen.Items.Count > 0 ? _screen.Problem : null" />
        <MudTable T="AgentListItem" Items="_screen.Items" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="list-grid" data-grid="agents">
            <HeaderContent>
                <MudTh>Agent</MudTh>
                <MudTh>Scope</MudTh>
                <MudTh>Endpoint</MudTh>
                <MudTh>Assistant</MudTh>
                <MudTh>Sub-agents</MudTh>
                <MudTh>Tools</MudTh>
            </HeaderContent>
            <RowTemplate Context="agent">
                <MudTd DataLabel="Agent">
                    <MudLink Href="@_screen.DrawerUri(agent.Id.ToString())" Class="tool-name" data-agent="@agent.Slug">@agent.DisplayName</MudLink>
                    <span class="tool-hint">@agent.Slug</span>
                </MudTd>
                <MudTd DataLabel="Scope">@agent.Scope</MudTd>
                <MudTd DataLabel="Endpoint">@EndpointName(agent.ModelEndpointId)</MudTd>
                <MudTd DataLabel="Assistant">@AssistantNames(agent.Slug)</MudTd>
                <MudTd DataLabel="Sub-agents">@agent.SubAgentCount</MudTd>
                <MudTd DataLabel="Tools">@agent.ToolCount</MudTd>
            </RowTemplate>
        </MudTable>
    </ChildContent>
</ListPage>

<ListDrawer @ref="_drawer" Open="Id is not null" Title="@DrawerTitle" Wide="true" Dirty="IsDirty" OnClose="_screen.CloseDrawer">
    @if (_form is null)
    {
        @if (_drawerProblem is not null)
        {
            <ProblemMessage Problem="_drawerProblem" />
        }
        else
        {
            <MudProgressLinear Indeterminate="true" />
        }
    }
    else
    {
        <form @onsubmit="SaveAsync" data-form="agent">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_form.DisplayName" Label="Name" Variant="Variant.Outlined" Required="true" />
                <MudTextField @bind-Value="_form.Slug" Label="Slug" Variant="Variant.Outlined" Required="true"
                              HelperText="The name the calling model sees when it delegates to this agent: lowercase letters, digits and dashes." />
                <MudTextField @bind-Value="_form.Description" Label="Description" Variant="Variant.Outlined" Lines="2"
                              HelperText="Written for the calling model: what this agent does and how to brief it." />
                <MudTextField @bind-Value="_form.SystemPrompt" Label="System prompt" Variant="Variant.Outlined" Lines="6" />

                <label class="tool-policy">Model endpoint
                    <select aria-label="Model endpoint" @bind="_form.ModelEndpointId">
                        <option value="">Same as the caller</option>
                        @foreach (var endpoint in _endpoints)
                        {
                            <option value="@endpoint.Id">@endpoint.Name</option>
                        }
                    </select>
                </label>

                <label class="tool-policy">Who can use it
                    <select aria-label="Scope" @bind="_form.Scope">
                        <option value="Tenant">This tenant</option>
                        <option value="Global">Every tenant</option>
                    </select>
                </label>

                <div>
                    <MudText Typo="Typo.subtitle2">Sub-agents</MudText>
                    <MudText Typo="Typo.body2" Class="tool-hint">The agents this one may call as tools. Say what should happen when one of them fails: its error goes back to this agent, which decides how to go on, or the whole answer stops.</MudText>
                    @foreach (var other in _allAgents.Where(a => a.Id != _editing?.Id))
                    {
                        var slug = other.Slug;
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudCheckBox T="bool" Value="_form.SubAgents.ContainsKey(slug)" ValueChanged="on => ToggleSub(slug, on)"
                                         Label="@other.DisplayName" Dense="true" />
                            @if (_form.SubAgents.TryGetValue(slug, out var policy))
                            {
                                <label class="tool-policy">If it fails
                                    <select aria-label="@($"If {slug} fails")" value="@policy" @onchange="e => _form.SubAgents[slug] = e.Value?.ToString() ?? FailurePolicies.ReturnError">
                                        <option value="@FailurePolicies.ReturnError">Report it to this agent</option>
                                        <option value="@FailurePolicies.AbortTurn">Stop the whole answer</option>
                                    </select>
                                </label>
                            }
                        </MudStack>
                    }
                </div>

                @if (_editing is not null)
                {
                    <div>
                        <MudText Typo="Typo.subtitle2">Tools</MudText>
                        @if (_tools is null)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (_tools.Pool.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="tool-hint">No tool is available to this agent yet.</MudText>
                        }
                        else
                        {
                            <AgentToolPicker Pool="_tools.Pool" Active="_activeTools" Manifests="_manifests" Changed="ToolsChanged" HasSkills="_skillIds.Count > 0" />
                            @foreach (var warning in _tools.Warnings)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">@warning.Message</MudAlert>
                            }
                        }
                    </div>
                }
                <div data-section="skills">
                    <MudText Typo="Typo.subtitle2">Skills</MudText>
                    @if (_allSkills.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="tool-hint">No skill exists yet. Create one on the Skills page.</MudText>
                    }
                    else
                    {
                        @foreach (var skill in _allSkills)
                        {
                            <MudCheckBox T="bool" Value="_skillIds.Contains(skill.Id)" ValueChanged="on => ToggleSkill(skill.Id, on)"
                                         Label="@skill.Slug" Color="Color.Primary" Dense="true" />
                        }
                        @if (_skillIds.Count > SkillsWarnAbove)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2" data-warning="skills-count">
                                @_skillIds.Count skills: small models choose worse among many. This is only a warning.
                            </MudAlert>
                        }
                        @if (EndpointWithoutTools)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2" data-notice="skills-inert">
                                The model endpoint of this agent does not support tools: its skills are saved but not used until another endpoint is chosen.
                            </MudAlert>
                        }
                    }
                </div>
                <div data-section="assistant">
                    <MudSwitch T="bool" @bind-Value="_form.OfferAsAssistant" Label="Offer as an assistant" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="tool-hint">People start a chat with an assistant, which answers through this agent.</MudText>
                    @if (_form.OfferAsAssistant)
                    {
                        <MudStack Spacing="2" Class="mt-2">
                            <MudTextField @bind-Value="_form.AssistantName" Label="Assistant name" Variant="Variant.Outlined"
                                          HelperText="Shown in the chat. Empty uses the agent's name." />
                            @if (_form.SubAgents.Count > 0)
                            {
                                <MudNumericField T="int" @bind-Value="_form.MaxParallelSubAgents" Label="Sub-agents at the same time" Variant="Variant.Outlined" Min="1"
                                                 HelperText="1 runs them one after the other." />
                            }
                        </MudStack>
                    }
                </div>

                @if (_form.SubAgents.Count + _activeTools.Count > WarnAbove)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-warning="size">
                        @(_form.SubAgents.Count + _activeTools.Count) sub-agents and tools: small models choose worse among many. This is only a warning.
                    </MudAlert>
                }

                <ProblemMessage Problem="_formProblem" />
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">@(_editing is null ? "Create" : "Save changes")</MudButton>
                    @if (_editing is not null)
                    {
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" Disabled="_busy"
                                   StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                    }
                </MudStack>
            </MudStack>
        </form>
    }
</ListDrawer>

@code {
    // Spec 013 D-30: informational, not a limit.
    internal const int WarnAbove = 10;

    private const string InheritedEndpoint = "inherit";

    private static readonly IReadOnlyList<FilterOption> ScopeOptions = [new("global", "Global"), new("tenant", "Tenant")];

    private sealed class AgentForm
    {
        public string Slug { get; set; } = string.Empty;

        public string DisplayName { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string SystemPrompt { get; set; } = string.Empty;

        public string ModelEndpointId { get; set; } = string.Empty;

        public string Scope { get; set; } = "Tenant";

        public IReadOnlyList<Guid> ScopeTenantIds { get; set; } = [];

        public Dictionary<string, string> SubAgents { get; } = [];

        public bool OfferAsAssistant { get; set; }

        public string AssistantName { get; set; } = string.Empty;

        public int MaxParallelSubAgents { get; set; } = 1;
    }

    private ListDrawer? _drawer;
    private ListScreen<AgentListItem> _screen = null!;
    private List<AgentListItem> _allAgents = [];
    private List<ModelEndpointInfo> _endpoints = [];
    private List<AssistantInfo> _assistants = [];
    private IReadOnlyList<AssistantSummary> _assistantSummaries = [];
    private IReadOnlyList<FilterOption> EndpointOptions => [new(InheritedEndpoint, "Same as the caller"), .. _endpoints.Select(e => new FilterOption(e.Id.ToString(), e.Name))];

    // The assistant this form manages: the first one that answers through the agent being edited.
    private AssistantInfo? _assistant;
    private AgentDocument? _editing;
    private AgentForm? _form;
    private AgentTools? _tools;
    private readonly HashSet<Guid> _activeTools = [];
    private readonly Dictionary<Guid, string> _manifests = [];

    // Skills of the agent (spec 017 D-26): the options are the visible ones, the set is saved after the agent.
    private const int SkillsWarnAbove = 10;
    private List<SkillSummary> _allSkills = [];
    private readonly HashSet<Guid> _skillIds = [];
    private readonly HashSet<Guid> _savedSkillIds = [];

    private bool EndpointWithoutTools =>
        Guid.TryParse(_form?.ModelEndpointId, out var endpointId) && _endpoints.Any(endpoint => endpoint.Id == endpointId && !endpoint.SupportsTools);

    private void ToggleSkill(Guid id, bool on)
    {
        if (on)
        {
            _skillIds.Add(id);
        }
        else
        {
            _skillIds.Remove(id);
        }
    }
    private ApiProblem? _drawerProblem;
    private ApiProblem? _formProblem;
    private ApiProblem? _carriedProblem;
    private string? _openedId;
    private string _opened = string.Empty;
    private string? _notice;
    private bool _busy;

    /// <summary>The drawer: <c>new</c> or the id of the agent. Without it only the list shows.</summary>
    [Parameter]
    public string? Id { get; set; }

    private string DrawerTitle => _form is null ? "Agent" : _editing is null ? "New agent" : $"Edit {_editing.DisplayName}";

    private bool IsDirty => _form is not null && Snapshot() != _opened;

    protected override async Task OnInitializedAsync()
    {
        _screen = new ListScreen<AgentListItem>(Navigation, "/agents", LoadAsync, () => InvokeAsync(StateHasChanged));

        var endpoints = await Api.ListModelEndpointsAsync();
        _endpoints = endpoints.IsSuccess ? endpoints.Value : [];
        await LoadAssistantsAsync();
        await _screen.ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_openedId == Id)
        {
            return;
        }

        _openedId = Id;
        _editing = null;
        _assistant = null;
        _form = null;
        _tools = null;
        _activeTools.Clear();
        _manifests.Clear();
        _skillIds.Clear();
        _savedSkillIds.Clear();
        _drawerProblem = null;
        _formProblem = _carriedProblem;
        _carriedProblem = null;

        if (Id is null)
        {
            return;
        }

        if (Id == ListScreen<AgentListItem>.NewId)
        {
            _form = new AgentForm();
            _opened = Snapshot();
            return;
        }

        if (!Guid.TryParse(Id, out var id))
        {
            _drawerProblem = NotFound;
            return;
        }

        await OpenAsync(id);
    }

    private static readonly ApiProblem NotFound = new(404, "agent.not_found", "There is no such agent.", new Dictionary<string, string[]>());

    // The list is filtered here: the server returns every agent of the tenant, and there are few.
    private async Task<ApiResult<Page<AgentListItem>>> LoadAsync(ListQuery query, string? cursor)
    {
        var result = await Api.ListAgentItemsAsync();
        if (!result.IsSuccess)
        {
            return ApiResult.Fail<Page<AgentListItem>>(result.Problem!);
        }

        _allAgents = result.Value;
        var answering = _assistants.Where(a => query.Assistant.Contains(a.Id)).Select(a => a.RootAgentSlug).ToHashSet(StringComparer.Ordinal);
        var items = result.Value.Where(agent => Matches(agent, query, answering)).ToList();
        return ApiResult.Ok(new Page<AgentListItem>(items, null));
    }

    private static bool Matches(AgentListItem agent, ListQuery query, HashSet<string> answering)
    {
        if (!string.IsNullOrWhiteSpace(query.Q)
            && !agent.DisplayName.Contains(query.Q, StringComparison.OrdinalIgnoreCase)
            && !agent.Slug.Contains(query.Q, StringComparison.OrdinalIgnoreCase)
            && !agent.Description.Contains(query.Q, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (query.Scope.Count > 0 && !query.Scope.Contains(agent.Scope, StringComparer.OrdinalIgnoreCase))
        {
            return false;
        }

        if (query.Type.Count > 0 && !query.Type.Contains(agent.ModelEndpointId?.ToString() ?? InheritedEndpoint, StringComparer.OrdinalIgnoreCase))
        {
            return false;
        }

        return query.Assistant.Count == 0 || answering.Contains(agent.Slug);
    }

    private async Task LoadAssistantsAsync()
    {
        var assistants = await Api.ListAssistantInfosAsync();
        _assistants = assistants.IsSuccess ? assistants.Value : [];
        _assistantSummaries = [.. _assistants.Select(a => new AssistantSummary(a.Id, a.Name, a.RootAgentSlug))];
    }

    private string EndpointName(Guid? id) =>
        id is null ? "Same as the caller" : _endpoints.FirstOrDefault(e => e.Id == id)?.Name ?? "Unknown";

    private string AssistantNames(string slug)
    {
        var names = _assistants.Where(a => a.RootAgentSlug == slug).Select(a => a.Name).ToList();
        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private async Task OpenAsync(Guid id)
    {
        var result = await Api.GetAgentAsync(id);
        if (!result.IsSuccess)
        {
            _drawerProblem = result.Problem;
            return;
        }

        // Opening an agent to read or change its prompt completes the checklist step of that name.
        _ = Onboarding.MarkAsync("prompt");

        var agent = result.Value;
        _editing = agent;
        _form = new AgentForm
        {
            Slug = agent.Slug,
            DisplayName = agent.DisplayName,
            Description = agent.Description,
            SystemPrompt = agent.SystemPrompt,
            ModelEndpointId = agent.ModelEndpointId?.ToString() ?? string.Empty,
            Scope = agent.Scope,
            ScopeTenantIds = agent.ScopeTenantIds,
        };
        foreach (var edge in agent.SubAgents)
        {
            _form.SubAgents[edge.Slug] = edge.FailurePolicy;
        }

        _assistant = _assistants.FirstOrDefault(a => a.RootAgentSlug == agent.Slug);
        if (_assistant is not null)
        {
            _form.OfferAsAssistant = true;
            _form.AssistantName = _assistant.Name;
            _form.MaxParallelSubAgents = _assistant.MaxParallelSubAgents;
        }

        var skillOptions = await Api.ListSkillsAsync();
        _allSkills = skillOptions.IsSuccess ? skillOptions.Value : [];
        var assigned = await Api.GetAgentSkillsAsync(id);
        if (assigned.IsSuccess)
        {
            _skillIds.UnionWith(assigned.Value.Select(skill => skill.Id));
        }

        _savedSkillIds.Clear();
        _savedSkillIds.UnionWith(_skillIds);

        var tools = await Api.GetAgentToolsAsync(id);
        if (tools.IsSuccess)
        {
            _tools = tools.Value;
            _activeTools.UnionWith(tools.Value.Pool.Where(t => t.Active).Select(t => t.ToolId));
            foreach (var tool in tools.Value.Pool.Where(t => t.Manifest is not null))
            {
                _manifests[tool.ToolId] = tool.Manifest!;
            }
        }
        else
        {
            _formProblem = tools.Problem;
        }

        _opened = Snapshot();
    }

    // What the form holds, as one text: the drawer asks before closing only when it differs from what was opened.
    private string Snapshot() => _form is null
        ? string.Empty
        : string.Join(
            '|',
            _form.Slug,
            _form.DisplayName,
            _form.Description,
            _form.SystemPrompt,
            _form.ModelEndpointId,
            _form.Scope,
            _form.OfferAsAssistant,
            _form.AssistantName,
            _form.MaxParallelSubAgents,
            string.Join(',', _form.SubAgents.OrderBy(pair => pair.Key, StringComparer.Ordinal).Select(pair => $"{pair.Key}:{pair.Value}")),
            string.Join(',', _activeTools.Order()),
            string.Join(',', _manifests.OrderBy(pair => pair.Key).Select(pair => $"{pair.Key}:{pair.Value}")));

    private void ToggleSub(string slug, bool on)
    {
        if (on)
        {
            _form!.SubAgents[slug] = FailurePolicies.ReturnError;
        }
        else
        {
            _form!.SubAgents.Remove(slug);
        }
    }

    // The picker changes the sets itself; asking for a render keeps the drawer's unsaved-changes guard current.
    private Task ToolsChanged() => Task.CompletedTask;

    private async Task SaveAsync()
    {
        if (_form is null || _busy)
        {
            return;
        }

        _busy = true;
        var request = new AgentRequest(
            _form.Slug.Trim(),
            _form.DisplayName.Trim(),
            _form.Description.Trim(),
            _form.SystemPrompt,
            Guid.TryParse(_form.ModelEndpointId, out var endpoint) ? endpoint : null,
            _form.Scope,
            _form.ScopeTenantIds,
            [.. _form.SubAgents.OrderBy(pair => pair.Key, StringComparer.Ordinal).Select(pair => new SubAgentEdge(pair.Key, pair.Value))]);

        ApiResult result;
        Guid? savedId = _editing?.Id;
        if (_editing is null)
        {
            var created = await Api.CreateAgentAsync(request);
            result = created;
            savedId = created.IsSuccess ? created.Value.Id : null;
        }
        else
        {
            result = await Api.UpdateAgentAsync(_editing.Id, request);
        }

        var agentSaved = result.IsSuccess;

        // The tools are saved after the agent: attaching needs its own permission and its own checks.
        if (agentSaved && _tools is not null && savedId is { } id)
        {
            var manifests = _manifests.Where(pair => _activeTools.Contains(pair.Key)).ToDictionary(pair => pair.Key, pair => pair.Value);
            result = await Api.SetAgentToolsAsync(id, [.. _activeTools], manifests);
        }

        // The skills follow the agent the same way, with the same permission rule: assigning needs agents.manage (spec 017 D-15).
        // Only a change is sent: an agent whose skills did not change keeps its request count the same.
        if (agentSaved && savedId is { } skillAgentId && !_skillIds.SetEquals(_savedSkillIds))
        {
            var skillResult = await Api.SetAgentSkillsAsync(skillAgentId, [.. _skillIds]);
            if (!skillResult.IsSuccess)
            {
                result = skillResult;
            }
        }

        // The assistant follows the agent it answers through: the agent already exists by now.
        if (result.IsSuccess)
        {
            result = await SaveAssistantAsync(request.Slug);
        }

        _busy = false;
        if (result.IsSuccess)
        {
            _notice = $"{request.DisplayName} was saved.";
            await CloseAfterAsync();
            return;
        }

        _formProblem = result.Problem;

        // The agent is saved even when its tools or assistant were refused: the list must show it, and the form stays open for them.
        if (agentSaved)
        {
            await LoadAssistantsAsync();
            await _screen.ReloadAsync();
            if (_editing is null && savedId is { } created)
            {
                // A second save must update the agent just created, not add another.
                _carriedProblem = result.Problem;
                _drawer?.SkipNextGuard();
                _screen.OpenDrawer(created.ToString());
            }
        }
    }

    private async Task<ApiResult> SaveAssistantAsync(string slug)
    {
        var form = _form!;
        var name = string.IsNullOrWhiteSpace(form.AssistantName) ? form.DisplayName.Trim() : form.AssistantName.Trim();
        var parallel = form.SubAgents.Count > 0 ? form.MaxParallelSubAgents : (_assistant?.MaxParallelSubAgents ?? 1);

        if (!form.OfferAsAssistant)
        {
            return _assistant is null ? ApiResult.Success : await Api.DeleteAssistantAsync(_assistant.Id);
        }

        var request = new AssistantRequest(name, slug, parallel);
        if (_assistant is null)
        {
            return await Api.CreateAssistantAsync(request);
        }

        return await Api.UpdateAssistantAsync(_assistant.Id, request);
    }

    private async Task DeleteAsync()
    {
        var agent = _editing!;
        var assistants = _assistants.Where(a => a.RootAgentSlug == agent.Slug).ToList();
        var consequence = assistants.Count == 0
            ? "Agents that call it as a sub-agent must drop it first."
            : $"Its assistant {string.Join(", ", assistants.Select(a => a.Name))} goes with it; their conversations stay readable.";
        if (!await Confirmations.ConfirmDeleteAsync(Dialogs, $"Delete {agent.DisplayName}?", consequence, "Delete agent"))
        {
            return;
        }

        _busy = true;
        _formProblem = null;
        try
        {
            // An assistant cannot outlive its root agent; 409 lists the other assistants and agents that still reference the agent.
            foreach (var assistant in assistants)
            {
                var removed = await Api.DeleteAssistantAsync(assistant.Id);
                if (!removed.IsSuccess)
                {
                    _formProblem = removed.Problem;
                    return;
                }
            }

            var result = await Api.DeleteAgentAsync(agent.Id);
            if (!result.IsSuccess)
            {
                _formProblem = result.Problem;
                return;
            }

            _notice = $"{agent.DisplayName} was deleted.";
            await CloseAfterAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Saved or deleted: nothing is left to lose, so the drawer closes without asking.
    private async Task CloseAfterAsync()
    {
        _form = null;
        _drawer?.SkipNextGuard();
        _screen.CloseDrawer();
        await LoadAssistantsAsync();
        await _screen.ReloadAsync();
    }

    public void Dispose() => _screen.Dispose();
}
