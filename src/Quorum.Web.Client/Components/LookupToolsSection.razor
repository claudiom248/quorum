@* The lookup tools of the Tools page (spec 007 D-12): tools that hand lists of values to a model, configured here. *@
@inject QuorumApi Api

<MudText Typo="Typo.subtitle1" Class="mt-2 mb-1">Lookup tools</MudText>
<MudText Typo="Typo.body2" Class="tools-support-hint mb-3">
    A lookup tool lets an assistant read lists of values (the suppliers, the departments, the audiences) so it knows what exists before it
    searches. Choose the lists here, and the knowledge bases it may also ask about live. Create the lists in Knowledge; activate a tool on an
    assistant in Settings.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_loadProblem is not null)
{
    <ProblemMessage Problem="_loadProblem" />
    <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync">Try again</MudButton>
}
else
{
    @if (_notice is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3" role="status">@_notice</MudAlert>
    }

    <ProblemMessage Problem="_problem" />

    @foreach (var tool in _tools)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-3 lookup-tool" data-lookup-tool="@tool.Name">
            <div class="tool-row-head">
                <span class="tool-name">lookup__@tool.Name</span>
                @if (tool.Shared)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Shared with you</MudChip>
                }

                @foreach (var lookup in tool.Lookups)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@lookup.Name</MudChip>
                }
            </div>
            @if (!tool.Shared)
            {
                <div class="tool-hint">
                    @ToolAdminView.ScopeSummary(tool.Scope, _assistants)
                    @if (tool.KnowledgeBases.Count > 0)
                    {
                        <span> · also asks live: @string.Join(", ", tool.KnowledgeBases.Select(k => k.Name))</span>
                    }
                </div>
            }

            @foreach (var warning in tool.Warnings)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2" data-warning="@warning.Code">@warning.Message</MudAlert>
            }

            <ToolRow @key="(tool.Id, _rowGeneration)" Tool="AsToolInfo(tool)" ReadOnly="tool.Shared" Busy="_busy" OnChange="ChangeToolAsync" />

            @if (!tool.Shared)
            {
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="() => EditAsync(tool.Id)"
                               StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Disabled="_busy"
                               OnClick="() => _deleting = tool.Id" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
                </MudStack>
            }

            @if (_deleting == tool.Id)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                    Delete lookup__@tool.Name? It is removed from every assistant. The audit log keeps its name.
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Disabled="_busy"
                                   OnClick="() => DeleteAsync(tool)">Delete tool</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _deleting = null">Cancel</MudButton>
                    </MudStack>
                </MudAlert>
            }
        </MudPaper>
    }

    @if (_tools.Count == 0 && _form is null)
    {
        <MudText Typo="Typo.body2" Class="tools-support-hint mb-3">No lookup tool is configured yet.</MudText>
    }

    @if (_form is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartNew" Disabled="_busy"
                   StartIcon="@Icons.Material.Filled.Add">Add lookup tool</MudButton>
    }
    else
    {
        var form = _form;
        var inUse = LookupToolView.KnowledgeBasesInUse(form, _choices);
        var fields = RagToolView.Candidates(inUse, _details, _dictionary);
        var exposed = fields.Fields.Where(f => form.ExposedFieldIds.Contains(f.Id)).ToList();
        <MudPaper Outlined="true" Class="pa-4 mb-3" data-form="lookup">
            <form @onsubmit="SaveAsync">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.subtitle1">@(form.IsNew ? "Add lookup tool" : $"Edit lookup__{form.OriginalName}")</MudText>
                    <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" Required="true" MaxLength="@LookupToolLimits.MaxNameLength"
                                  HelperText="Lower-case letters, digits, '-' and '_'. The model sees the tool as lookup__name." />
                    <MudTextField @bind-Value="form.Description" Label="Description" Variant="Variant.Outlined" Required="true" Lines="3" MaxLength="@LookupToolLimits.MaxDescriptionLength"
                                  HelperText="For the model: when to read these lists. Each list's own description is added to it." />

                    <MudText Typo="Typo.subtitle2">Lookups (@form.Lookups.Count of @LookupToolLimits.MaxLookups)</MudText>
                    @if (_choices.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No lookup exists yet. <MudLink Href="knowledge/lookups">Create one</MudLink> first.
                        </MudAlert>
                    }

                    @foreach (var choice in _choices)
                    {
                        var binding = form.Lookups.FirstOrDefault(l => l.LookupId == choice.Id);
                        <div class="exposed-field" data-lookup-choice="@choice.Label">
                            <MudCheckBox T="bool" Value="binding is not null" ValueChanged="on => ToggleLookupAsync(choice, on)" Dense="true"
                                         Disabled="@(binding is null && form.Lookups.Count >= LookupToolLimits.MaxLookups)" Label="@choice.Label" />
                            @if (binding is not null)
                            {
                                <MudTextField T="string" @bind-Value="binding.Alias" Label="@($"Alias of {choice.Label}")" Placeholder="@choice.Name"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="alias-input"
                                              HelperText="The name the model sees. Leave empty to use the list's own name; needed when two lists have the same name." />
                            }
                        </div>
                    }

                    <div class="tool-hint">
                        Lists of a knowledge base shared with you are not shown here: bind the manual lookups instead, or ask its owner to share the tool.
                    </div>

                    <MudText Typo="Typo.subtitle2">Knowledge bases to ask live (@form.KnowledgeBaseIds.Count of @LookupToolLimits.MaxKnowledgeBases)</MudText>
                    <div class="tool-hint">
                        Optional. With one, the model can also ask which documents match some filters, and how many, straight from the store. Without
                        any, it only reads the saved lists.
                    </div>
                    @foreach (var knowledgeBase in _bases)
                    {
                        var selected = form.KnowledgeBaseIds.Contains(knowledgeBase.Id);
                        <MudCheckBox T="bool" Value="selected" ValueChanged="on => ToggleKnowledgeBaseAsync(knowledgeBase, on)" Dense="true"
                                     Disabled="@(!selected && form.KnowledgeBaseIds.Count >= LookupToolLimits.MaxKnowledgeBases)"
                                     Label="@(knowledgeBase.Shared ? $"{knowledgeBase.Name} (shared with you)" : knowledgeBase.Name)" />
                    }

                    @if (inUse.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2">Fields the model can filter on (@form.ExposedFieldIds.Count of @LookupToolLimits.MaxExposedFields)</MudText>
                        @if (!fields.Complete)
                        {
                            <div class="tool-hint">
                                A knowledge base shared with you does not show its mapping, so every dictionary field is offered.
                                The server refuses fields that none of the knowledge bases maps.
                            </div>
                        }

                        @if (fields.Fields.Count == 0)
                        {
                            <div class="tool-hint">These knowledge bases map no metadata field: the model cannot filter.</div>
                        }

                        @foreach (var (cluster, group) in KnowledgeAdminView.GroupByCluster(fields.Fields))
                        {
                            @if (cluster is not null)
                            {
                                <div class="tool-hint cluster-heading" data-cluster="@cluster">@cluster</div>
                            }

                            @foreach (var field in group)
                            {
                                var on = form.ExposedFieldIds.Contains(field.Id);
                                var label = KnowledgeAdminView.FieldLabel(field, fields.Fields);
                                <div class="exposed-field">
                                    <MudCheckBox T="bool" Value="on" ValueChanged="value => ToggleExposed(field, value)" Dense="true"
                                                 Disabled="@(!on && form.ExposedFieldIds.Count >= LookupToolLimits.MaxExposedFields)"
                                                 Label="@($"{label} ({KnowledgeAdminView.TypeLabel(field.Type).ToLowerInvariant()})")" />
                                    @if (on)
                                    {
                                        <MudTextField T="string" Value="@(form.Aliases.GetValueOrDefault(field.Id) ?? string.Empty)" ValueChanged="alias => form.SetAlias(field, alias)"
                                                      Label="@($"Alias of {label}")" Placeholder="@field.Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Immediate="true" Class="alias-input" HelperText="The name the model sees. Leave empty to use the field's name." />
                                    }
                                </div>
                            }
                        }

                        <MudText Typo="Typo.subtitle2">Fixed filters</MudText>
                        <div class="tool-hint">
                            Always applied, combined with AND, never visible to the model and never overridden by it. They cut a slice out of
                            the lists, such as one department; each different slice is computed on its own.
                        </div>
                        @foreach (var id in form.FixedFilterFieldIds.ToList())
                        {
                            @if (_dictionary.FirstOrDefault(f => f.Id == id) is { } filterField)
                            {
                                <div class="fixed-filter" data-filter="@filterField.Name">
                                    <div class="tool-row-head">
                                        <span class="tool-name">@KnowledgeAdminView.FieldLabel(filterField, _dictionary)</span>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Remove the filter on {filterField.Name}")"
                                                       OnClick="() => form.RemoveFixedFilter(id, _dictionary)" />
                                    </div>
                                    <FilterEditor Parameters="form.ParametersOf(filterField)" Values="form.FilterValues" />
                                </div>
                            }
                        }

                        @if (form.UnshownFilters.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                The stored filters include @string.Join(", ", form.UnshownFilters), which this editor cannot show (the field is gone).
                                Saving drops them.
                            </MudAlert>
                        }

                        @if (fields.Fields.Where(f => !form.FixedFilterFieldIds.Contains(f.Id)).ToList() is { Count: > 0 } available)
                        {
                            <label class="tool-policy">Add a fixed filter on
                                <select @key="form.FixedFilterFieldIds.Count" aria-label="Add a fixed filter" value="" @onchange="e => AddFixedFilter(e.Value?.ToString())">
                                    <option value="">Choose a field…</option>
                                    @foreach (var field in available)
                                    {
                                        <option value="@field.Id">@KnowledgeAdminView.FieldLabel(field, fields.Fields)</option>
                                    }
                                </select>
                            </label>
                        }
                    }

                    <label class="tool-policy">Policy
                        <select aria-label="Policy" @bind="form.Policy">
                            <option value="@ToolPolicies.Auto">Run without asking</option>
                            <option value="@ToolPolicies.Confirm">Ask before running</option>
                        </select>
                    </label>

                    <ScopeEditor Form="form.Scope" Assistants="_assistants" Subject="tool"
                                 GlobalWarning="Every tenant of this installation will see the tool. All its lookups and knowledge bases must be visible to every tenant too." />

                    <div class="tool-hint" data-operations>
                        Operations the model will get: <span class="tool-name">@string.Join(", ", LookupToolView.Operations(form.KnowledgeBaseIds.Count > 0))</span>
                        (the saved definition below is the real one).
                    </div>

                    @if (_formProblems.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <ul class="problem-list">
                                @foreach (var message in _formProblems)
                                {
                                    <li>@message</li>
                                }
                            </ul>
                        </MudAlert>
                    }

                    <ProblemMessage Problem="_formProblem" />

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="CancelForm" Disabled="_busy">Close</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Save</MudButton>
                    </MudStack>

                    @foreach (var warning in _formWarnings)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-warning="@warning.Code">@warning.Message</MudAlert>
                    }

                    @if (_definitions.Count > 0)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">
                            @(_definitions.Count == 1 ? "Definition the model gets" : $"Definitions the model gets ({_definitions.Count} functions)")
                        </MudText>
                        @if (_definitions.Count > 1)
                        {
                            <div class="tool-hint" data-definitions-total>@RagToolView.SizeText(_definitions.Sum(d => d.EstimatedTokens)) in all</div>
                        }

                        @foreach (var definition in _definitions)
                        {
                            <div data-definition="@definition.Name" class="mb-2">
                                <div class="tool-hint">
                                    <span class="tool-name">@definition.Name</span> · @RagToolView.SizeText(definition.EstimatedTokens)
                                </div>
                                <div class="tool-row-description">@definition.Description</div>
                                <details class="tool-detail" open="@(_definitions.Count == 1)">
                                    <summary>Input schema</summary>
                                    <pre class="tool-pre">@RagToolView.FormatSchema(definition.InputSchema)</pre>
                                </details>
                            </div>
                        }
                    }
                    else if (!form.IsNew)
                    {
                        <div class="tool-hint">No lookup of this tool is visible, so it is not offered to any model.</div>
                    }
                </MudStack>
            </form>
        </MudPaper>
    }
}

@code {
    private List<LookupToolListItem> _tools = [];
    private List<KnowledgeBaseListItem> _bases = [];
    private IReadOnlyList<LookupChoice> _choices = [];
    private IReadOnlyList<DictionaryField> _dictionary = [];
    private IReadOnlyList<AssistantSummary> _assistants = [];
    private readonly Dictionary<Guid, KnowledgeBaseDetail> _details = [];
    private ApiProblem? _loadProblem;
    private ApiProblem? _problem;
    private bool _loading = true;
    private bool _loaded;
    private bool _busy;
    private int _rowGeneration;
    private string? _notice;
    private Guid? _deleting;

    private LookupToolForm? _form;
    private IReadOnlyList<string> _formProblems = [];
    private ApiProblem? _formProblem;
    private IReadOnlyList<LookupToolDefinitionInfo> _definitions = [];
    private IReadOnlyList<ToolWarning> _formWarnings = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loadProblem = null;

        var tools = await Api.ListLookupToolsAsync();
        if (!tools.IsSuccess)
        {
            FailLoad(tools.Problem!);
            return;
        }

        var bases = await Api.ListKnowledgeBasesAsync();
        if (!bases.IsSuccess)
        {
            FailLoad(bases.Problem!);
            return;
        }

        var dictionary = await Api.ListDictionaryAsync();
        if (!dictionary.IsSuccess)
        {
            FailLoad(dictionary.Problem!);
            return;
        }

        var manual = await Api.ListManualLookupsAsync();
        if (!manual.IsSuccess)
        {
            FailLoad(manual.Problem!);
            return;
        }

        var lookups = new Dictionary<Guid, IReadOnlyList<KnowledgeBaseLookupInfo>>();
        foreach (var knowledgeBase in bases.Value.Where(k => !k.Shared))
        {
            var listed = await Api.ListKnowledgeBaseLookupsAsync(knowledgeBase.Id);
            if (!listed.IsSuccess)
            {
                FailLoad(listed.Problem!);
                return;
            }

            lookups[knowledgeBase.Id] = listed.Value;
        }

        _tools = tools.Value;
        _bases = bases.Value;
        _dictionary = dictionary.Value;
        _choices = LookupToolView.Choices(bases.Value, lookups, manual.Value);

        var assistants = await Api.ListAssistantsAsync();
        _assistants = assistants.IsSuccess ? assistants.Value : [];
        _loaded = true;
    }

    // Before anything was loaded the problem replaces the section; afterwards the data on screen stays, with the problem next to it.
    private void FailLoad(ApiProblem problem)
    {
        if (_loaded)
        {
            _problem = problem;
        }
        else
        {
            _loadProblem = problem;
        }
    }

    // The tool row lets the admin enable, disable and set the policy like for any other tool.
    private static ToolInfo AsToolInfo(LookupToolListItem tool) => new(
        tool.Id,
        "Lookup",
        null,
        tool.Name,
        tool.Lookups.Count > 0 ? $"Reads {string.Join(", ", tool.Lookups.Select(l => l.Name))}." : string.Empty,
        tool.State,
        tool.Policy,
        null);

    private async Task ChangeToolAsync((ToolInfo Tool, string State, string Policy) change)
    {
        await RunAsync(async () =>
        {
            var result = await Api.UpdateToolAsync(change.Tool.Id, change.State, change.Policy);
            if (!result.IsSuccess)
            {
                // The control already shows what the admin chose: draw the rows again from what the server has.
                _problem = result.Problem;
                _rowGeneration++;
            }

            await LoadAsync();
        });
    }

    private async Task LoadDetailAsync(Guid knowledgeBaseId)
    {
        if (_details.ContainsKey(knowledgeBaseId) || _bases.FirstOrDefault(b => b.Id == knowledgeBaseId) is not { Shared: false })
        {
            return;
        }

        var detail = await Api.GetKnowledgeBaseAsync(knowledgeBaseId);
        if (detail.IsSuccess)
        {
            _details[knowledgeBaseId] = detail.Value;
        }
    }

    private async Task LoadDetailsInUseAsync(LookupToolForm form)
    {
        foreach (var id in LookupToolView.KnowledgeBasesInUse(form, _choices))
        {
            await LoadDetailAsync(id);
        }
    }

    // The fields the tool may expose follow the knowledge bases it queries and those its lists come from.
    private void FollowCandidates(LookupToolForm form)
    {
        var choices = RagToolView.Candidates(LookupToolView.KnowledgeBasesInUse(form, _choices), _details, _dictionary);
        form.ApplyCandidates(choices.Fields, exposeNew: choices.Complete);
    }

    private void StartNew()
    {
        ClearMessages();
        _form = new LookupToolForm();
    }

    private async Task EditAsync(Guid id)
    {
        await RunAsync(async () =>
        {
            var detail = await Api.GetLookupToolAsync(id);
            if (!detail.IsSuccess)
            {
                _problem = detail.Problem;
                return;
            }

            await OpenAsync(detail.Value);
        });
    }

    private async Task OpenAsync(LookupToolDetail detail)
    {
        var probe = new LookupToolForm();
        probe.KnowledgeBaseIds.AddRange(detail.KnowledgeBaseIds);
        probe.Lookups.AddRange(detail.Lookups.Select(l => new LookupBindingForm(l.LookupId)));
        await LoadDetailsInUseAsync(probe);

        var mapped = RagToolView.Candidates(LookupToolView.KnowledgeBasesInUse(probe, _choices), _details, _dictionary);
        var form = LookupToolForm.From(detail, _dictionary, mapped.Fields);
        form.KnowCandidates(mapped.Fields);
        _form = form;
        // One function for each thing the tool does; a server that sends only one definition still shows it.
        _definitions = detail.Definitions is { Count: > 0 } ? detail.Definitions : detail.Definition is null ? [] : [detail.Definition];
        _formWarnings = detail.Warnings;
        _formProblems = [];
        _formProblem = null;
    }

    private async Task ToggleLookupAsync(LookupChoice choice, bool on)
    {
        var form = _form!;
        if (on)
        {
            form.AddLookup(choice.Id);
            await LoadDetailsInUseAsync(form);
        }
        else
        {
            form.RemoveLookup(choice.Id);
        }

        FollowCandidates(form);
    }

    private async Task ToggleKnowledgeBaseAsync(KnowledgeBaseListItem knowledgeBase, bool on)
    {
        var form = _form!;
        if (on)
        {
            if (!form.KnowledgeBaseIds.Contains(knowledgeBase.Id))
            {
                form.KnowledgeBaseIds.Add(knowledgeBase.Id);
            }

            await LoadDetailAsync(knowledgeBase.Id);
        }
        else
        {
            form.KnowledgeBaseIds.Remove(knowledgeBase.Id);
        }

        FollowCandidates(form);
    }

    private void ToggleExposed(DictionaryField field, bool on)
    {
        if (on)
        {
            _form!.ExposedFieldIds.Add(field.Id);
        }
        else
        {
            _form!.ExposedFieldIds.Remove(field.Id);
        }
    }

    private void AddFixedFilter(string? value)
    {
        if (Guid.TryParse(value, out var id))
        {
            _form!.AddFixedFilter(id);
        }
    }

    private void CancelForm()
    {
        _form = null;
        _formProblems = [];
        _formProblem = null;
        _definitions = [];
        _formWarnings = [];
    }

    private async Task SaveAsync()
    {
        var form = _form!;
        _formProblem = null;
        _formProblems = form.Problems(_dictionary, _choices);
        if (_formProblems.Count > 0)
        {
            return;
        }

        var request = form.ToRequest(_dictionary);
        await RunAsync(async () =>
        {
            Guid id;
            if (form.Id is { } existing)
            {
                var updated = await Api.UpdateLookupToolAsync(existing, request);
                if (!updated.IsSuccess)
                {
                    _formProblem = updated.Problem;
                    return;
                }

                id = existing;
            }
            else
            {
                var created = await Api.CreateLookupToolAsync(request);
                if (!created.IsSuccess)
                {
                    _formProblem = created.Problem;
                    return;
                }

                id = created.Value.Id;
            }

            await LoadAsync();

            // The editor stays open on the saved tool, with the definition the model gets, what it takes of the context and the warnings.
            var saved = await Api.GetLookupToolAsync(id);
            if (saved.IsSuccess)
            {
                await OpenAsync(saved.Value);
                _notice = $"lookup__{request.Name} was saved. Activate it on an assistant in Settings for a model to use it.";
            }
            else
            {
                CancelForm();
                _problem = saved.Problem;
            }
        });
    }

    private async Task DeleteAsync(LookupToolListItem tool)
    {
        await RunAsync(async () =>
        {
            var result = await Api.DeleteLookupToolAsync(tool.Id);
            _deleting = null;
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _notice = $"lookup__{tool.Name} was deleted.";
            await LoadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        ClearMessages(keepForm: true);
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearMessages(bool keepForm = false)
    {
        _problem = null;
        _notice = null;
        _deleting = null;
        if (!keepForm)
        {
            CancelForm();
        }
    }
}
