@* The state and the policy of one tool, changed in place: the switch and the policy of a reviewed tool, or approve and keep
   disabled for one that waits for review. The page sends what the admin chose; a shared tool only reads. *@

@if (ReadOnly)
{
    <div class="tool-hint">@ToolAdminView.StateLabel(Tool.State) · @PolicyLabel · managed by the tenant that owns it</div>
}
else if (Tool.State == ToolStates.PendingReview)
{
    <div class="tool-row-controls">
        <label class="tool-policy">Policy
            <select aria-label="Policy of @Tool.Name" @bind="_policy" disabled="@Busy">
                <option value="@ToolPolicies.Confirm">Ask before running</option>
                <option value="@ToolPolicies.Auto">Run without asking</option>
            </select>
        </label>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="Busy"
                   OnClick="() => ChangeAsync(ToolStates.Enabled, _policy)">Approve and enable</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="Busy"
                   OnClick="() => ChangeAsync(ToolStates.Disabled, _policy)">Keep disabled</MudButton>
    </div>
}
else
{
    <div class="tool-row-controls">
        @* The label is the switch's accessible name: the tool's name is added for screen readers, so the switches differ. *@
        <MudSwitch T="bool" Value="Tool.State == ToolStates.Enabled" ValueChanged="EnabledChangedAsync" Color="Color.Primary"
                   Disabled="Busy">Enabled<span class="sr-only"> (@Tool.Name)</span></MudSwitch>
        <label class="tool-policy">Policy
            <select aria-label="Policy of @Tool.Name" value="@Tool.Policy" @onchange="PolicyChangedAsync" disabled="@Busy">
                <option value="@ToolPolicies.Confirm">Ask before running</option>
                <option value="@ToolPolicies.Auto">Run without asking</option>
            </select>
        </label>
    </div>
}

@code {
    private string _policy = ToolPolicies.Confirm;
    private (Guid Id, string Policy)? _synced;

    [Parameter, EditorRequired]
    public ToolInfo Tool { get; set; } = null!;

    /// <summary>A tool of a source another tenant shares: its review belongs to the owner.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Called with the state and the policy the admin chose; the page sends them to the server.</summary>
    [Parameter]
    public EventCallback<(ToolInfo Tool, string State, string Policy)> OnChange { get; set; }

    private string PolicyLabel => Tool.Policy == ToolPolicies.Auto ? "runs without asking" : "asks before running";

    // A tool pending review shows the policy it came back with (Confirm) until the admin picks another; a re-render of the
    // page must not undo that choice, so the stored value is copied only when it changed.
    protected override void OnParametersSet()
    {
        if (_synced != (Tool.Id, Tool.Policy))
        {
            _policy = Tool.Policy;
            _synced = (Tool.Id, Tool.Policy);
        }
    }

    private Task EnabledChangedAsync(bool enabled) =>
        ChangeAsync(enabled ? ToolStates.Enabled : ToolStates.Disabled, Tool.Policy);

    private Task PolicyChangedAsync(ChangeEventArgs e) =>
        ChangeAsync(Tool.State, e.Value?.ToString() ?? Tool.Policy);

    private Task ChangeAsync(string state, string policy) => OnChange.InvokeAsync((Tool, state, policy));
}
