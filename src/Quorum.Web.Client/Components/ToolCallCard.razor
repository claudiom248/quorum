<div class="tool-card state-@Call.State.ToString().ToLowerInvariant()">
    <div class="tool-head">
        <MudIcon Icon="@Icons.Material.Outlined.Build" Size="Size.Small" />
        <span class="tool-name">@Call.DisplayName</span>
        <span class="tool-status">@Call.StatusLabel</span>
    </div>

    @if (Call.HasArguments)
    {
        <details class="tool-detail">
            <summary>Arguments</summary>
            <pre class="tool-pre">@Call.ArgumentsText</pre>
        </details>
    }

    @if (Call.Result is not null)
    {
        <details class="tool-detail">
            <summary>Result (@Call.Result.Length characters)</summary>
            <pre class="tool-pre">@Call.Result</pre>
        </details>
    }

    @if (Call.State == ToolCallState.WaitingForAnswer)
    {
        <form class="tool-question" @onsubmit="SubmitAnswerAsync">
            <div class="tool-question-text">@Call.Question</div>
            <div class="tool-question-row">
                <input type="text" @bind="_answer" @bind:event="oninput" placeholder="Your answer" aria-label="Your answer"
                       maxlength="4000" disabled="@Call.Busy" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           Disabled="@(Call.Busy || string.IsNullOrWhiteSpace(_answer))">Send</MudButton>
            </div>
            @if (Call.ExpiresAt is { } until)
            {
                <div class="tool-hint">Answer before @until.ToLocalTime().ToString("HH:mm:ss"); otherwise the assistant goes on without it.</div>
            }
        </form>
    }
</div>

@if (Call.State == ToolCallState.WaitingForConfirmation)
{
    <div class="tool-dialog-backdrop">
        <div class="tool-dialog" role="dialog" aria-modal="true" aria-label="Confirm tool call">
            <h2>Allow this tool to run?</h2>
            <p>The assistant wants to call <strong>@Call.DisplayName</strong>@(Call.HasArguments ? " with these arguments:" : " without arguments.")</p>
            @if (Call.HasArguments)
            {
                <pre class="tool-pre">@Call.ArgumentsText</pre>
            }
            @if (Call.ExpiresAt is { } until)
            {
                <p class="tool-hint">Nothing runs until you approve. Decide before @until.ToLocalTime().ToString("HH:mm:ss"); otherwise the call is denied.</p>
            }
            <div class="tool-dialog-actions">
                <MudButton Variant="Variant.Outlined" Disabled="Call.Busy" OnClick="() => DecideAsync(false)">Deny</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Call.Busy" OnClick="() => DecideAsync(true)">Approve</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private string _answer = string.Empty;

    [Parameter, EditorRequired]
    public ToolCallView Call { get; set; } = default!;

    /// <summary>The user approved (<see langword="true"/>) or denied the call.</summary>
    [Parameter]
    public EventCallback<bool> OnDecide { get; set; }

    [Parameter]
    public EventCallback<string> OnAnswer { get; set; }

    private Task DecideAsync(bool approved) => OnDecide.InvokeAsync(approved);

    private async Task SubmitAnswerAsync()
    {
        var answer = _answer.Trim();
        if (answer.Length > 0 && !Call.Busy)
        {
            await OnAnswer.InvokeAsync(answer);
        }
    }
}
