<nav class="knowledge-nav" aria-label="Knowledge">
    <MudButton Href="knowledge" Variant="@(Current == "bases" ? Variant.Filled : Variant.Outlined)" Color="@(Current == "bases" ? Color.Primary : Color.Default)"
               Size="Size.Small" StartIcon="@Icons.Material.Filled.LibraryBooks">Knowledge bases</MudButton>
    <MudButton Href="knowledge/dictionary" Variant="@(Current == "dictionary" ? Variant.Filled : Variant.Outlined)" Color="@(Current == "dictionary" ? Color.Primary : Color.Default)"
               Size="Size.Small" StartIcon="@Icons.Material.Filled.Label">Dictionary</MudButton>
</nav>

@code {
    /// <summary><c>bases</c> or <c>dictionary</c>.</summary>
    [Parameter, EditorRequired]
    public string Current { get; set; } = "bases";
}
