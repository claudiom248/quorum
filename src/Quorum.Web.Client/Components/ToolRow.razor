<div class="tool-row state-@Tool.State.ToLowerInvariant()" data-tool="@Tool.Name">
    <div class="tool-row-head">
        <span class="tool-name">@Tool.Name</span>
        @if (Tool.State == ToolStates.PendingReview)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@ToolAdminView.StateLabel(Tool.State)</MudChip>
        }
        @foreach (var hint in ToolAdminView.DescribeAnnotations(Tool.Annotations))
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="tool-hint-chip">@hint</MudChip>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Tool.Description))
    {
        <div class="tool-row-description">@Tool.Description</div>
    }

    @if (ToolAdminView.DescribeAnnotations(Tool.Annotations).Count > 0)
    {
        <div class="tool-hint">Hints claimed by the server. They do not change the policy.</div>
    }

    @if (NameEditable && !ReadOnly)
    {
        <div class="tool-row-controls tool-row-rename">
            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" MaxLength="40"
                          HelperText="@($"Default: {Tool.DefaultName}. The model and people read this name.")" data-tool-name />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="Busy || !NameChanged" OnClick="() => OnRename.InvokeAsync((Tool, _name.Trim()))">Rename</MudButton>
            @if (Tool.DefaultName is { } defaultName && Tool.Name != defaultName)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Busy" OnClick="() => OnRename.InvokeAsync((Tool, string.Empty))">Back to @defaultName</MudButton>
            }
        </div>
    }

    <ToolStateCell Tool="Tool" ReadOnly="ReadOnly" Busy="Busy" OnChange="OnChange" />
</div>

@code {
    [Parameter, EditorRequired]
    public ToolInfo Tool { get; set; } = null!;

    /// <summary>A tool of a server another tenant shares: its review belongs to the owner.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The name can be changed (the built-in tools): the row asks <see cref="OnRename"/> for it.</summary>
    [Parameter]
    public bool NameEditable { get; set; }

    /// <summary>Called with the name the admin typed; an empty one gives the default back.</summary>
    [Parameter]
    public EventCallback<(ToolInfo Tool, string Name)> OnRename { get; set; }

    private string _name = string.Empty;

    private bool NameChanged => !string.IsNullOrWhiteSpace(_name) && _name.Trim() != Tool.Name;

    protected override void OnInitialized() => _name = Tool.Name;

    /// <summary>Called with the state and the policy the admin chose; the page sends them to the server.</summary>
    [Parameter]
    public EventCallback<(ToolInfo Tool, string State, string Policy)> OnChange { get; set; }
}
