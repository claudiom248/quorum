@* The guided registration of a knowledge base (spec 003 D-9, D-19): connection → inspection → mapping → lookups → scope → save. *@
@inject QuorumApi Api

<MudPaper Outlined="true" Class="pa-4 mb-3" data-form="knowledge-base">
    <MudText Typo="Typo.subtitle1" Class="mb-2">@(Draft.IsNew ? "Register a knowledge base" : $"Edit {Draft.Name}")</MudText>

    <ol class="wizard-steps" aria-label="Steps">
        @foreach (var (step, label, number) in VisibleSteps)
        {
            var current = step == _step;
            <li class="@(current ? "current" : step <= _reached ? "reached" : "pending")" aria-current="@(current ? "step" : null)">
                <button type="button" disabled="@(step > _reached || _busy)" @onclick="() => GoTo(step)">@number. @label</button>
            </li>
        }
    </ol>

    @switch (_step)
    {
        case WizardStep.Connection:
            <MudStack Spacing="3" data-step="connection">
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    @(Draft.IsPgVector
                        ? "Quorum reads a table or view of a PostgreSQL database with pgvector that already holds your documents, prepared by whoever owns the data. It never writes to it: a read-only user is best."
                        : "Quorum reads a collection that already holds your documents, prepared by whoever owns the data. It never writes to it.")
                </MudText>
                @if (Draft.IsNew)
                {
                    <label class="tool-policy">Store
                        <select aria-label="Store" value="@Draft.Kind" @onchange="e => ChangeKind(e.Value?.ToString())">
                            <option value="@KnowledgeBaseKinds.Qdrant">Qdrant</option>
                            <option value="@KnowledgeBaseKinds.PgVector">PostgreSQL (pgvector)</option>
                        </select>
                    </label>
                }
                <MudTextField @bind-Value="Draft.Name" Label="Name" Variant="Variant.Outlined" Required="true" MaxLength="40"
                              HelperText="Lower-case letters, digits, '-' and '_'. The model sees it when a tool searches several knowledge bases." />
                <MudTextField @bind-Value="Draft.Description" Label="Description" Variant="Variant.Outlined" Required="true" Lines="3" MaxLength="1000"
                              HelperText="What is in it. The model reads this to choose where to search." />
                @if (Draft.IsPgVector)
                {
                    <MudCheckBox T="bool" @bind-Value="Draft.UseConnectionString" Dense="true" Label="Use a connection string instead of separate fields" />
                    @if (Draft.UseConnectionString)
                    {
                        <MudTextField @bind-Value="Draft.ConnectionString" Label="Connection string" InputType="InputType.Password" Variant="Variant.Outlined" autocomplete="off"
                                      HelperText="@ConnectionStringHint" />
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="2" Class="mapping-row-fields">
                            <MudTextField @bind-Value="Draft.Host" Label="Host" Variant="Variant.Outlined" Required="true" />
                            <MudTextField @bind-Value="Draft.Port" Label="Port" Variant="Variant.Outlined" HelperText="5432 when empty." />
                        </MudStack>
                        <MudStack Row="true" Spacing="2" Class="mapping-row-fields">
                            <MudTextField @bind-Value="Draft.Database" Label="Database" Variant="Variant.Outlined" Required="true" />
                            <MudTextField @bind-Value="Draft.Username" Label="User" Variant="Variant.Outlined" Required="true" autocomplete="off" />
                        </MudStack>
                        <MudTextField @bind-Value="Draft.Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" autocomplete="off"
                                      HelperText="@PasswordHint" />
                        <label class="tool-policy">SSL mode
                            <select aria-label="SSL mode" @bind="Draft.SslMode">
                                <option value="">Default (prefer)</option>
                                @foreach (var mode in KnowledgeBaseDraft.SslModes)
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </select>
                        </label>
                    }
                    @if (Draft.NeedsPasswordAgain)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            The host, port, database or user changed: the stored password is only kept for the same account, so type the password again.
                        </MudAlert>
                    }

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="mapping-row-fields">
                        <MudTextField @bind-Value="Draft.DatabaseSchema" Label="Schema" Variant="Variant.Outlined" HelperText="public when empty." />
                        <MudTextField @bind-Value="_relationFilter" Label="Filter the list" Variant="Variant.Outlined" Immediate="true" HelperText="Part of a name." />
                        <MudButton Variant="Variant.Outlined" OnClick="ListRelationsAsync" Disabled="_busy"
                                   StartIcon="@Icons.Material.Filled.Storage">List relations</MudButton>
                    </MudStack>
                    @if (_relations is { } relations)
                    {
                        <div data-relations>
                            @foreach (var warning in relations.Warnings)
                            {
                                <MudAlert Severity="@SeverityOf(warning)" Variant="Variant.Outlined" data-warning="@warning.Code">@warning.Message</MudAlert>
                            }

                            @if (relations.Reachable && relations.Relations.Count == 0 && relations.Warnings.Count == 0)
                            {
                                <div class="tool-hint">No table or view with a vector column that this user can read was found.</div>
                            }

                            @foreach (var relation in relations.Relations)
                            {
                                var selected = relation.Name == Draft.Table && relation.Schema == (Draft.DatabaseSchema.Trim().Length > 0 ? Draft.DatabaseSchema.Trim() : relation.Schema);
                                <div class="mapping-row @(selected ? "current" : string.Empty)" data-relation="@(relation.Schema + "." + relation.Name)">
                                    <MudButton Variant="@(selected ? Variant.Filled : Variant.Text)" Size="Size.Small" Style="text-transform: none" OnClick="() => Draft.UseRelation(relation)">
                                        @relation.Schema.@relation.Name
                                    </MudButton>
                                    <span class="tool-hint">@KnowledgeAdminView.DescribeRelation(relation)</span>
                                </div>
                            }

                            @if (relations.Truncated)
                            {
                                <div class="tool-hint">Only the first relations are shown: filter the list to find the one you need.</div>
                            }
                        </div>
                    }
                    <MudTextField @bind-Value="Draft.Table" Label="Table or view" Variant="Variant.Outlined" Required="true"
                                  HelperText="Choose it from the list, or type its name." />
                }
                else
                {
                <MudTextField @bind-Value="Draft.Url" Label="Qdrant address (gRPC)" Variant="Variant.Outlined" Required="true"
                              HelperText="The gRPC port, 6334 by default, e.g. http://qdrant:6334. The REST port, 6333, does not work here." />
                <MudTextField @bind-Value="Draft.ApiKey" Label="API key" InputType="InputType.Password" Variant="Variant.Outlined" autocomplete="off"
                              HelperText="@ApiKeyHint" />
                <MudTextField @bind-Value="Draft.Collection" Label="Collection" Variant="Variant.Outlined" Required="true" />
                <MudTextField @bind-Value="Draft.VectorName" Label="Vector name" Variant="Variant.Outlined"
                              HelperText="Only when the collection has several vectors; the inspection tells you." />
                }
                <MudTextField @bind-Value="Draft.EmbeddingModel" Label="Embedding model" Variant="Variant.Outlined" Required="true"
                              HelperText="The model that embedded the documents, served by the model endpoint of this installation, e.g. nomic-embed-text." />
                <MudTextField @bind-Value="Draft.QueryPrefix" Label="Query prefix" Variant="Variant.Outlined" MaxLength="200"
                              HelperText="Added before every question, if the model needs it (e.g. 'search_query: ' for nomic, e5 or bge models). Optional." />
                @if (Draft.NeedsApiKeyAgain)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        The address changed: the stored key is only kept for the same address, so type the key again.
                    </MudAlert>
                }

                @if (_showProblems && Draft.ConnectionProblems() is { Count: > 0 } connectionProblems)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <ul class="problem-list">
                            @foreach (var message in connectionProblems)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <ProblemMessage Problem="_problem" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InspectAsync" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.Search">@(Draft.IsNew ? (Draft.IsPgVector ? "Inspect relation" : "Inspect collection") : "Inspect again")</MudButton>
                </MudStack>
                @if (!Draft.IsNew)
                {
                    <div class="tool-hint">Inspecting again replaces the mapping with a new draft.</div>
                }
            </MudStack>
            break;

        case WizardStep.Inspection:
            <MudStack Spacing="3" data-step="inspection">
                @if (_inspection is { } inspection)
                {
                    <ul class="problem-list findings">
                        @foreach (var finding in KnowledgeAdminView.Findings(inspection, Draft.Kind))
                        {
                            <li>@finding</li>
                        }
                    </ul>

                    @foreach (var warning in inspection.Warnings)
                    {
                        <MudAlert Severity="@SeverityOf(warning)" Variant="Variant.Outlined" data-warning="@warning.Code">
                            @warning.Message
                            @if (!string.IsNullOrEmpty(warning.Path))
                            {
                                <span class="tool-hint"> (@warning.Path)</span>
                            }
                        </MudAlert>
                    }

                    @if (inspection.UnindexedFields.Count > 0)
                    {
                        <div class="tool-hint" data-unindexed>
                            @(Draft.IsPgVector ? "Without an index, filters on these columns can be slow on a large relation:" : "Without a payload index, filters on these fields can be slow on a large collection:")
                            @string.Join(", ", inspection.UnindexedFields). Quorum never creates indexes: ask the data owner.
                        </div>
                    }

                    @if (Draft.IsPgVector)
                    {
                        @if (inspection.Vectors.Count > 0)
                        {
                            <label class="tool-policy">Vector column
                                <select aria-label="Vector column" @bind="Draft.VectorColumn">
                                    <option value="">Choose…</option>
                                    @foreach (var vector in inspection.Vectors.Where(v => v.Name is not null))
                                    {
                                        <option value="@vector.Name">@vector.Name · @KnowledgeAdminView.DescribeVector(new VectorInfo(null, vector.Size, vector.Distance))</option>
                                    }
                                </select>
                            </label>
                            <label class="tool-policy">Distance
                                <select aria-label="Distance" @bind="Draft.Distance">
                                    <option value="">Cosine (default)</option>
                                    @foreach (var distance in KnowledgeBaseDraft.Distances)
                                    {
                                        <option value="@distance">@distance</option>
                                    }
                                </select>
                            </label>
                            <div class="tool-hint">
                                The distance must be the one the embedding model was trained for; it is proposed from the index of the column.
                            </div>
                        }

                        @if (Draft.NeedsVectorColumnChoice(inspection))
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                The relation has several vector columns: choose which one holds the embeddings, then inspect again to check its size.
                            </MudAlert>
                        }
                    }
                    else if (inspection.Vectors.Count > 1 || Draft.VectorName.Length > 0)
                    {
                        <label class="tool-policy">Vector
                            <select aria-label="Vector" @bind="Draft.VectorName">
                                <option value="">Choose…</option>
                                @foreach (var vector in inspection.Vectors.Where(v => v.Name is not null))
                                {
                                    <option value="@vector.Name">@KnowledgeAdminView.DescribeVector(vector)</option>
                                }
                            </select>
                        </label>
                        @if (Draft.NeedsVectorChoice(inspection))
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                The collection has several vectors: choose which one holds the embeddings, then inspect again to check its size.
                            </MudAlert>
                        }
                    }
                }

                <MudTextField @bind-Value="Draft.Schema" Label="@(Draft.IsPgVector ? "Row schema (optional)" : "Payload schema (optional)")" Variant="Variant.Outlined" Lines="6" Class="schema-input"
                              HelperText="@(Draft.IsPgVector ? "Paste a plain JSON Schema of a row (columns as properties, json columns as objects), if the data owner gave you one, instead of sampling rows. Up to 100 KB." : "Paste a plain JSON Schema of the payload, if the data owner gave you one, instead of sampling points. Up to 100 KB.")" />
                @if (Draft.SchemaProblem() is { } schemaProblem)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@schemaProblem</MudAlert>
                }

                <ProblemMessage Problem="_problem" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="() => GoTo(WizardStep.Connection)" Disabled="_busy">Back</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="InspectAsync" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.Search">@(string.IsNullOrWhiteSpace(Draft.Schema) ? "Inspect again" : "Inspect with this schema")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToMapping"
                               Disabled="@(_busy || Draft.Mapping is null || (_inspection is { } found && !KnowledgeAdminView.CanReview(found)))">Review the mapping</MudButton>
                </MudStack>
            </MudStack>
            break;

        case WizardStep.Mapping when Draft.Mapping is { } mapping:
            <MudStack Spacing="3" data-step="mapping">
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    @(Draft.IsPgVector
                        ? "Say what each column means. Nothing is saved until you confirm. A key inside a json column is written column.key, e.g. cmetadata.year."
                        : "Say what each payload field means. Nothing is saved until you confirm. Paths use dots for nested objects, e.g. meta.year.")
                </MudText>

                <MudText Typo="Typo.subtitle2">What the model reads and cites</MudText>
                <MudTextField @bind-Value="mapping.Text" Label="Text (required)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              HelperText="@(Draft.IsPgVector ? "The column with the text of the chunk." : "The payload field with the text of the chunk.")" />
                <MudTextField @bind-Value="mapping.DocumentId" Label="Document id" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="mapping.Title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="mapping.Position" Label="Position (page or section)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="mapping.SourceUrl" Label="Source URL" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />

                <MudText Typo="Typo.subtitle2" Class="mt-2">Metadata fields</MudText>
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    Each one is bound to a field of the dictionary, which models use to filter. Use an existing field's name to reuse it.
                </MudText>

                @foreach (var review in mapping.Review(Dictionary))
                {
                    var row = review.Row;
                    <div class="mapping-row @(review.Problems.Count > 0 ? "has-problems" : string.Empty)" data-path="@row.Path">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="mapping-row-fields">
                            <MudTextField @bind-Value="row.Path" Label="@(Draft.IsPgVector ? "Column" : "Payload path")" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="row.Name" Label="Dictionary field" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="row.Cluster" Label="Cluster (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="@($"Remove {row.Path}")" OnClick="() => mapping.RemoveRow(row)" />
                        </MudStack>
                        <div class="tool-hint">
                            @if (review.Existing is { } existing)
                            {
                                <span>Existing field@(existing.Cluster is null ? string.Empty : $" in cluster {existing.Cluster}"): @KnowledgeAdminView.TypeLabel(existing.Type), @KnowledgeAdminView.DictionaryScopeLabel(existing.Scope.Kind).ToLowerInvariant()</span>
                            }
                            else if (row.Name.Trim().Length > 0)
                            {
                                <label class="tool-policy">New field of type
                                    <select aria-label="@($"Type of {row.Name}")" value="@review.EffectiveType" @onchange="e => row.Type = e.Value?.ToString()">
                                        @foreach (var type in DictionaryFieldTypes.All)
                                        {
                                            <option value="@type">@KnowledgeAdminView.TypeLabel(type)</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        @if (!row.Chosen)
                        {
                            <div class="tool-hint" data-candidates>
                                Several fields are called "@row.Name". Choose one:
                                @foreach (var candidate in row.Candidates)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => row.Pick(candidate)">@(candidate.Cluster ?? "no cluster") · @KnowledgeAdminView.TypeLabel(candidate.Type)</MudChip>
                                }
                                or type another cluster to create a new field.
                            </div>
                        }
                        @if (review.HasTypeConflict)
                        {
                            <MudCheckBox T="bool" @bind-Value="row.AcceptExistingType" Dense="true"
                                         Label="@($"Use the dictionary's type ({KnowledgeAdminView.TypeLabel(review.Existing!.Type)}): the values fit")" />
                        }

                        @foreach (var problem in review.Problems)
                        {
                            <div class="mapping-problem" role="alert">@problem</div>
                        }
                    </div>
                }

                <div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => mapping.AddRow()"
                               StartIcon="@Icons.Material.Filled.Add">Add a field</MudButton>
                </div>

                @if (mapping.NewFields(Dictionary) is { Count: > 0 } created)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-new-fields>
                        These fields are not in the dictionary yet: @string.Join(", ", created.Select(f => $"{(f.Cluster is null ? f.Name : f.Cluster + "/" + f.Name)} ({KnowledgeAdminView.TypeLabel(f.Type).ToLowerInvariant()})")).
                        <MudCheckBox T="bool" @bind-Value="mapping.ConfirmCreate" Dense="true" Label="Create them when I save" />
                    </MudAlert>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="() => GoTo(WizardStep.Inspection)" Disabled="_busy">Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToLookups" Disabled="_busy">Next</MudButton>
                </MudStack>
                @if (_showProblems && mapping.Problems(Dictionary) is { Count: > 0 } mappingProblems)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <ul class="problem-list">
                            @foreach (var message in mappingProblems)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </MudAlert>
                }
            </MudStack>
            break;

        case WizardStep.Lookups when Draft.Mapping is { } lookupMapping:
            <MudStack Spacing="3" data-step="lookups">
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    Lookups are lists of values that models read to know what exists, e.g. the suppliers or the departments. Quorum computes them in the
                    background from the @Draft.SourceWord and keeps them in its own database. All of this is optional: skip the step if the @Draft.SourceWord needs no list.
                </MudText>

                <MudText Typo="Typo.subtitle2">Fields to list</MudText>
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    Each marked field gets a list of its distinct values with how many documents have each. Only text and list of texts fields can be listed.
                    @(Draft.IsPgVector ? "Without an index on these columns the lists take longer to compute on a large relation: Quorum never creates one." : "Filters on these fields should have a payload index in the collection: Quorum never creates one.")
                </MudText>
                @foreach (var review in lookupMapping.Review(Dictionary))
                {
                    var row = review.Row;
                    <div class="lookup-field-row" data-lookup-field="@row.Path">
                        <MudCheckBox T="bool" @bind-Value="row.Listable" Dense="true"
                                     Label="@($"List the values of {(row.Name.Trim().Length > 0 ? row.Name.Trim() : row.Path)} ({row.Path})")" />
                        @if (lookupMapping.EntityName.Trim().Length > 0)
                        {
                            <MudCheckBox T="bool" @bind-Value="row.EntityAttribute" Dense="true" Label="Show it beside each entity" />
                        }
                    </div>
                }
                @if (lookupMapping.Rows.Count == 0)
                {
                    <div class="tool-hint">No metadata field is mapped, so there is nothing to list.</div>
                }

                <MudText Typo="Typo.subtitle2" Class="mt-2">What the counts count</MudText>
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    A document is usually split into many chunks. If one chunk of each document is marked in the @Draft.FieldWord (e.g. is_first_chunk is true),
                    say which: the lists then count documents. Without it they count chunks.
                </MudText>
                <MudStack Row="true" Spacing="2" Class="mapping-row-fields">
                    <MudTextField @bind-Value="lookupMapping.CountedPointPath" Label="@($"Counted point: {Draft.PathWord}")" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  HelperText="e.g. is_first_chunk or chunk_index" />
                    <MudTextField @bind-Value="lookupMapping.CountedPointValue" Label="Counted point: value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  HelperText="true, a number such as 0, or a text. Put a text that looks like a number in double quotes." />
                </MudStack>

                <MudText Typo="Typo.subtitle2" Class="mt-2">Entities</MudText>
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    If every @Draft.RecordWord of the @Draft.SourceWord is a thing in itself (a person, a product) rather than a piece of a document, say which @Draft.FieldWord holds
                    its name. Up to @LookupLimits.MaxEntityAttributes fields can be shown beside the name.
                </MudText>
                <MudTextField @bind-Value="lookupMapping.EntityName" Label="@($"Entity name: {Draft.PathWord}")" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />

                <MudText Typo="Typo.subtitle2" Class="mt-2">Refresh</MudText>
                <MudNumericField T="int" @bind-Value="Draft.LookupRefreshHours" Label="Refresh every (hours)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="LookupLimits.MinRefreshHours" Max="LookupLimits.MaxRefreshHours"
                                 HelperText="@($"{LookupLimits.MinRefreshHours} to {LookupLimits.MaxRefreshHours}. You can also refresh a knowledge base on demand from the Lookups page.")" />

                @if (_showProblems && Draft.LookupProblems(Dictionary) is { Count: > 0 } lookupProblems)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <ul class="problem-list">
                            @foreach (var message in lookupProblems)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="() => GoTo(WizardStep.Mapping)" Disabled="_busy">Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToScope" Disabled="_busy">Next</MudButton>
                </MudStack>
            </MudStack>
            break;

        case WizardStep.Scope:
            <MudStack Spacing="3" data-step="scope">
                <ScopePicker Form="Draft.Scope" Assistants="Assistants" Tenants="Tenants" Subject="knowledge base"
                             GlobalWarning="Every tenant of this installation will be able to search this knowledge base. It can use only dictionary fields that are visible to every tenant." />
                @if (Draft.ScopeProblem() is { } scopeProblem)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@scopeProblem</MudAlert>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="() => GoTo(WizardStep.Lookups)" Disabled="_busy">Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToReview" Disabled="_busy">Next</MudButton>
                </MudStack>
            </MudStack>
            break;

        default:
            <MudStack Spacing="3" data-step="review">
                <ul class="problem-list findings">
                    @foreach (var line in Draft.Summary(Dictionary, Assistants))
                    {
                        <li>@line</li>
                    }
                </ul>
                <MudText Typo="Typo.body2" Class="tools-support-hint">
                    The knowledge base is saved even if it cannot be reached yet; it is then marked unavailable and the reason is shown.
                </MudText>

                @if (Draft.Problems(Dictionary) is { Count: > 0 } problems)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        Fix these before saving:
                        <ul class="problem-list">
                            @foreach (var message in problems)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <ProblemMessage Problem="_problem" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="() => GoTo(WizardStep.Scope)" Disabled="_busy">Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                               Disabled="@(_busy || Draft.Problems(Dictionary).Count > 0)">@(Draft.IsNew ? "Register" : "Save changes")</MudButton>
                </MudStack>
            </MudStack>
            break;
    }
</MudPaper>

@code {
    private enum WizardStep
    {
        Connection,
        Inspection,
        Mapping,
        Lookups,
        Scope,
        Review,
    }

    private static readonly (WizardStep Step, string Label)[] Steps =
    [
        (WizardStep.Connection, "Connection"),
        (WizardStep.Inspection, "Inspection"),
        (WizardStep.Mapping, "Mapping"),
        (WizardStep.Lookups, "Lookups"),
        (WizardStep.Scope, "Who can use it"),
        (WizardStep.Review, "Save"),
    ];

    private WizardStep _step;
    // Editing a registration that has a mapping: every step can be opened, the admin may care about any of them.
    private WizardStep _reached;
    private bool _openedAll;
    private InspectResult? _inspection;
    private string? _inspected;
    private ApiProblem? _problem;
    private bool _busy;
    private bool _showProblems;

    [Parameter, EditorRequired]
    public KnowledgeBaseDraft Draft { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<DictionaryField> Dictionary { get; set; } = [];

    [Parameter]
    public IReadOnlyList<AssistantSummary> Assistants { get; set; } = [];

    [Parameter]
    public IReadOnlyList<TenantSummary>? Tenants { get; set; }

    /// <summary>Called after the server saved the knowledge base (even if it is unavailable).</summary>
    [Parameter]
    public EventCallback<SavedKnowledgeBase> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private IEnumerable<(WizardStep Step, string Label, int Number)> VisibleSteps => Steps.Select((s, index) => (s.Step, s.Label, index + 1));

    private RelationsResult? _relations;
    private string? _relationFilter;

    private string PasswordHint => Draft.HadPassword
        ? "A password is stored. Leave empty to keep it. It is only kept while the host, port, database and user stay the same."
        : "Optional if the server needs none. Stored encrypted and never shown again.";

    private string ConnectionStringHint => Draft.HadConnectionString
        ? "A connection string is stored. Leave empty to keep it. Npgsql format, e.g. Host=db;Database=docs;Username=reader;Password=…"
        : "Npgsql format, e.g. Host=db;Database=docs;Username=reader;Password=… Stored encrypted and never shown again.";

    private string ApiKeyHint => Draft.HadApiKey
        ? "A key is stored. Leave empty to keep it. It is only kept while the address stays the same."
        : "Optional. Stored encrypted and never shown again.";

    private static Severity SeverityOf(KnowledgeBaseWarning warning) => KnowledgeAdminView.LevelOf(warning) switch
    {
        WarningLevel.Error => Severity.Error,
        WarningLevel.Warning => Severity.Warning,
        _ => Severity.Info,
    };

    private static readonly ApiProblem StaleInspection = new(
        0,
        "client.stale_inspection",
        "The connection changed since the collection was inspected, so the mapping below it no longer applies: inspect the collection again.",
        new Dictionary<string, string[]>());

    // What the inspection and the draft mapping were made from. The vector is left out: choosing it does not change the mapping.
    private string Fingerprint() => string.Join(
        '\u001f',
        Draft.Kind,
        Draft.Url.Trim(),
        Draft.Collection.Trim(),
        Draft.EmbeddingModel.Trim(),
        Draft.QueryPrefix,
        Draft.Schema.Trim(),
        Draft.UseConnectionString,
        Draft.Host.Trim(),
        Draft.Port.Trim(),
        Draft.Database.Trim(),
        Draft.Username.Trim(),
        Draft.ConnectionString,
        Draft.DatabaseSchema.Trim(),
        Draft.Table.Trim());

    private bool InspectionIsStale => _inspected is not null && _inspected != Fingerprint();

    private void GoTo(WizardStep step)
    {
        _problem = null;
        _showProblems = false;

        // A mapping made from another collection must not be carried to this one: later steps need a new inspection.
        if (step > WizardStep.Connection && InspectionIsStale)
        {
            _inspection = null;
            _inspected = null;
            _reached = WizardStep.Connection;
            _step = WizardStep.Connection;
            _problem = StaleInspection;
            return;
        }

        _step = step;
    }

    private void Reach(WizardStep step)
    {
        _step = step;
        if (step > _reached)
        {
            _reached = step;
        }
    }

    protected override void OnParametersSet()
    {
        if (!_openedAll && !Draft.IsNew && Draft.Mapping is not null)
        {
            _openedAll = true;
            _reached = WizardStep.Review;
        }
    }

    private void Cancel() => OnCancel.InvokeAsync();

    private async Task InspectAsync()
    {
        _problem = null;
        _showProblems = true;
        if (Draft.ConnectionProblems().Count > 0 || Draft.SchemaProblem() is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.InspectKnowledgeBaseAsync(Draft.ToInspectRequest());
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _inspection = result.Value;
            _inspected = Fingerprint();
            if (KnowledgeAdminView.CanReview(result.Value))
            {
                Draft.UseInspection(result.Value);
            }

            _showProblems = false;
            Reach(WizardStep.Inspection);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToMapping()
    {
        _problem = InspectionIsStale ? StaleInspection : null;
        if (_problem is not null)
        {
            return;
        }

        Reach(WizardStep.Mapping);
    }

    private void ToLookups()
    {
        if (Draft.Mapping!.Problems(Dictionary).Count > 0)
        {
            _showProblems = true;
            return;
        }

        _showProblems = false;
        Reach(WizardStep.Lookups);
    }

    private void ChangeKind(string? kind)
    {
        if (kind is not null && kind != Draft.Kind)
        {
            Draft.Kind = kind;
            _inspection = null;
            _inspected = null;
            _relations = null;
            _reached = WizardStep.Connection;
            _problem = null;
        }
    }

    private async Task ListRelationsAsync()
    {
        _problem = null;
        _showProblems = false;
        if (Draft.PgVectorServerProblems() is { Count: > 0 } problems)
        {
            _problem = new ApiProblem(0, "client.invalid_connection", string.Join(' ', problems), new Dictionary<string, string[]>());
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.ListRelationsAsync(Draft.ToRelationsRequest(_relationFilter));
            if (!result.IsSuccess)
            {
                _problem = result.Problem;
                return;
            }

            _relations = result.Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToScope()
    {
        if (Draft.LookupProblems(Dictionary).Count > 0)
        {
            _showProblems = true;
            return;
        }

        _showProblems = false;
        Reach(WizardStep.Scope);
    }

    private void ToReview()
    {
        if (Draft.ScopeProblem() is not null)
        {
            return;
        }

        Reach(WizardStep.Review);
    }

    private async Task SaveAsync()
    {
        _problem = null;
        _busy = true;
        try
        {
            var request = Draft.ToRequest(Dictionary);
            if (Draft.Id is { } id)
            {
                var updated = await Api.UpdateKnowledgeBaseAsync(id, request);
                if (!updated.IsSuccess)
                {
                    _problem = updated.Problem;
                    return;
                }

                await OnSaved.InvokeAsync(new SavedKnowledgeBase(id, request.Name, updated.Value.Status, updated.Value.Warnings));
            }
            else
            {
                var created = await Api.CreateKnowledgeBaseAsync(request);
                if (!created.IsSuccess)
                {
                    _problem = created.Problem;
                    return;
                }

                await OnSaved.InvokeAsync(new SavedKnowledgeBase(created.Value.Id, request.Name, created.Value.Status, created.Value.Warnings));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
