@if (_view.HasSources)
{
    <div class="sources">
        @if (Streaming)
        {
            @* The text is still being written: what it cites is not known, so nothing is split or moved until the answer ends. *@
            <div class="sources-title">Sources</div>
            <ol class="sources-list">
                @foreach (var source in _view.Others)
                {
                    <li @key="source.Sections[0].Numbers[0]"><SourceEntry Document="source" /></li>
                }
            </ol>
        }

        @if (!Streaming && _view.Cited.Count > 0)
        {
            <div class="sources-title">Sources</div>
            <ol class="sources-list">
                @foreach (var source in _view.Cited)
                {
                    <li @key="source.Sections[0].Numbers[0]"><SourceEntry Document="source" /></li>
                }
            </ol>
        }

        @if (!Streaming && _view.Others.Count > 0)
        {
            <details class="sources-others">
                <summary>@(_view.Cited.Count > 0 ? "Other sources" : "Sources") (@_view.Others.Sum(document => document.Sections.Count))</summary>
                <ol class="sources-list">
                    @foreach (var source in _view.Others)
                    {
                        <li @key="source.Sections[0].Numbers[0]"><SourceEntry Document="source" /></li>
                    }
                </ol>
            </details>
        }
    </div>
}

@code {
    private SourcesView _view = new(null, string.Empty);

    /// <summary>The sources the answer received; rendered by number.</summary>
    [Parameter]
    public IReadOnlyList<MessageSourceDto>? Sources { get; set; }

    /// <summary>The answer's text, read for its <c>[n]</c> markers.</summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>The answer is still arriving: the sources are listed as they come, whatever the text cites so far.</summary>
    [Parameter]
    public bool Streaming { get; set; }

    protected override void OnParametersSet() => _view = new SourcesView(Sources, Streaming ? string.Empty : Text);
}
