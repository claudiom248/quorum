@if (Problem is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-3">
        @if (Problem.Errors.Count > 0)
        {
            <ul class="problem-list">
                @foreach (var message in Problem.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        }
        else
        {
            @Problem.Message
        }
    </MudAlert>
}

@code {
    [Parameter]
    public ApiProblem? Problem { get; set; }
}
