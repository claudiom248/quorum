<label class="tool-policy">Who can use it
    <select aria-label="Scope" @bind="Form.Kind">
        <option value="@ScopeKinds.Tenant">This tenant</option>
        <option value="@ScopeKinds.Assistant">Chosen assistants</option>
        <option value="@ScopeKinds.Global">Every tenant</option>
    </select>
</label>
@if (Form.Kind == ScopeKinds.Assistant)
{
    @foreach (var assistant in Assistants)
    {
        <MudCheckBox T="bool" Value="Form.AssistantIds.Contains(assistant.Id)"
                     ValueChanged="on => ToggleAssistant(assistant.Id, on)" Label="@assistant.Name" Dense="true" />
    }
}
else if (Form.Kind == ScopeKinds.Tenant)
{
    @if (Tenants is null)
    {
        @* The list of tenants is not known (not loaded, or not allowed): the ids are typed, as before. *@
        <MudTextField @bind-Value="Form.TenantsText" Label="Other tenants (ids, optional)" Variant="Variant.Outlined" Lines="2"
                      HelperText="@($"Tenants that may use the {Subject} besides this one, read-only. Leave empty to keep it to this tenant.")" />
    }
    else if (Others.Count > 0)
    {
        <MudSelect T="string" Label="Other tenants" Variant="Variant.Outlined" MultiSelection="true"
                   SelectedValues="SelectedTenants" SelectedValuesChanged="TenantsChanged" ToStringFunc="NameOf"
                   HelperText="@($"Tenants that may use the {Subject} besides this one, read-only. Leave empty to keep it to this tenant.")">
            @foreach (var tenant in Others)
            {
                <MudSelectItem T="string" Value="@tenant.Id.ToString()">@tenant.Name</MudSelectItem>
            }
        </MudSelect>
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@GlobalWarning</MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public ScopeForm Form { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<AssistantSummary> Assistants { get; set; } = [];

    /// <summary>The tenants of the installation, when known; <see langword="null"/> falls back to typing ids.</summary>
    [Parameter]
    public IReadOnlyList<TenantSummary>? Tenants { get; set; }

    /// <summary>What the scope covers, for the helper text: "knowledge base", "tool".</summary>
    [Parameter]
    public string Subject { get; set; } = "knowledge base";

    [Parameter]
    public string GlobalWarning { get; set; } = "Every tenant of this installation will see it.";

    private List<TenantSummary> Others => [.. (Tenants ?? []).Where(t => !t.Current)];

    private List<string> SelectedTenants =>
        [.. ToolAdminView.ParseIds(Form.TenantsText).Ids.Select(id => id.ToString())];

    private string NameOf(string value) =>
        Guid.TryParse(value, out var id) ? Tenants?.FirstOrDefault(t => t.Id == id)?.Name ?? value : value;

    private void TenantsChanged(IEnumerable<string>? values) =>
        Form.TenantsText = string.Join(Environment.NewLine, values ?? []);

    private void ToggleAssistant(Guid id, bool on)
    {
        if (on)
        {
            Form.AssistantIds.Add(id);
        }
        else
        {
            Form.AssistantIds.Remove(id);
        }
    }
}
