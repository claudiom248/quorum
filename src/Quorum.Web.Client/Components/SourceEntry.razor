@if (Document.IsOneLine)
{
    var place = Document.Sections[0];
    <span class="source-n">@Numbers(place)</span>
    <DocumentName Document="Document" />
}
else
{
    <span class="source-doc"><DocumentName Document="Document" /></span>
    <ul class="source-sections">
        @foreach (var place in Document.Sections)
        {
            <li @key="place.Numbers[0]">
                <span class="source-n">@Numbers(place)</span>
                @if (place.Href is { } href)
                {
                    <a href="@href" target="_blank" rel="noopener noreferrer">@(place.Position ?? Document.Label)</a>
                }
                else if (place.Position is not null)
                {
                    <span class="source-position">@place.Position</span>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public SourceDocument Document { get; set; } = null!;

    private static string Numbers(SourceSection place) => string.Join(' ', place.Numbers.Select(n => $"[{n}]"));
}
