<span class="source-n">@string.Join(' ', Source.Numbers.Select(n => $"[{n}]"))</span>
@if (Source.Href is { } href)
{
    <a href="@href" target="_blank" rel="noopener noreferrer">@Source.Label</a>
}
else
{
    <span class="source-label">@Source.Label</span>
}
@if (Source.Detail.Length > 0)
{
    <span class="source-detail">@Source.Detail</span>
}

@code {
    [Parameter, EditorRequired]
    public SourceItem Source { get; set; } = null!;
}
