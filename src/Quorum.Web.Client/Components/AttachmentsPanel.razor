@inject QuorumApi Api

<div class="attachments">
    <div class="attachments-bar">
        <label class="attach-button @(Disabled || _busy ? "disabled" : null)" title="Attach PDF, DOCX, TXT, Markdown or CSV files (up to 5 MB each)">
            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
            <span>Attach</span>
            <InputFile OnChange="OnFilesSelectedAsync" accept="@AttachmentRules.Accept" multiple
                       disabled="@(Disabled || _busy)" class="visually-hidden" />
        </label>

        @if (_busy)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }

        @foreach (var attachment in _attachments)
        {
            <span class="attachment-chip @(attachment.Id == _previewId ? "open" : null)">
                <button type="button" class="chip-name" title="Show the text the model receives" @onclick="() => TogglePreviewAsync(attachment)">
                    @attachment.FileName
                </button>
                <span class="chip-size">@AttachmentRules.FormatSize(attachment.SizeBytes) · @attachment.CharacterCount.ToString("N0") chars</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" title="Remove from this conversation"
                               Disabled="@(Disabled || _busy)" OnClick="() => RemoveAsync(attachment)" />
            </span>
        }
    </div>

    @if (_meter is not null && (_attachments.Count > 0 || _meter.Level != MeterLevel.Normal))
    {
        <div class="context-meter" title="@_meter.Details">
            <MudProgressLinear Value="@_meter.Percent" Color="@MeterColor(_meter.Level)" Size="Size.Small" />
            <span class="meter-label @(_meter.Level is MeterLevel.Critical or MeterLevel.Over ? "warn" : null)">
                @_meter.Label · @_meter.Details
            </span>
        </div>
    }

    @if (_previewId is not null)
    {
        <div class="attachment-preview">
            @if (_previewText is null)
            {
                <MudProgressLinear Indeterminate="true" Size="Size.Small" />
            }
            else
            {
                <pre>@_previewText</pre>
            }
        </div>
    }

    <ProblemMessage Problem="_problem" />
</div>

@code {
    private List<AttachmentInfo> _attachments = [];
    private ContextMeter? _meter;
    private ApiProblem? _problem;
    private Guid? _loadedFor;
    private Guid? _previewId;
    private string? _previewText;
    private bool _busy;

    /// <summary>The conversation the attachments belong to; <see langword="null"/> until the first message or attachment.</summary>
    [Parameter]
    public Guid? ConversationId { get; set; }

    /// <summary>Creates the conversation when the user attaches a file before writing anything.</summary>
    [Parameter]
    public Func<Task<Guid?>>? EnsureConversation { get; set; }

    /// <summary>True while an answer is being generated: the server refuses changes to the context then.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnSessionExpired { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (ConversationId == _loadedFor)
        {
            return;
        }

        _loadedFor = ConversationId;
        _previewId = null;
        _previewText = null;
        _problem = null;
        await ReloadAsync();
    }

    /// <summary>Reads the attachments and the budget again (after an answer, the messages take a share of it).</summary>
    public async Task ReloadAsync()
    {
        if (ConversationId is not { } id)
        {
            _attachments = [];
            _meter = null;
            StateHasChanged();
            return;
        }

        var list = await Api.ListAttachmentsAsync(id);
        if (list.IsSuccess)
        {
            _attachments = list.Value;
        }
        else if (await HandleAsync(list.Problem!))
        {
            return;
        }

        var context = await Api.GetContextAsync(id);
        _meter = context.IsSuccess ? ContextMeter.From(context.Value) : null;
        StateHasChanged();
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        _problem = null;
        _busy = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
            {
                if (AttachmentRules.Check(file.Name, file.Size) is { } refusal)
                {
                    _problem = Local(refusal);
                    break;
                }

                var id = ConversationId ?? await (EnsureConversation?.Invoke() ?? Task.FromResult<Guid?>(null));
                if (id is null)
                {
                    _problem = Local("The conversation could not be started.");
                    break;
                }

                // The conversation is known now: the parameter reaches us after the parent renders.
                ConversationId = id;
                _loadedFor = id;

                await using var stream = file.OpenReadStream(AttachmentRules.MaxFileBytes);
                var result = await Api.UploadAttachmentAsync(id.Value, stream, file.Name);
                if (!result.IsSuccess)
                {
                    if (await HandleAsync(result.Problem!))
                    {
                        return;
                    }

                    break;
                }
            }
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private async Task RemoveAsync(AttachmentInfo attachment)
    {
        if (ConversationId is not { } id)
        {
            return;
        }

        _problem = null;
        _busy = true;
        var result = await Api.RemoveAttachmentAsync(id, attachment.Id);
        _busy = false;

        if (!result.IsSuccess && await HandleAsync(result.Problem!))
        {
            return;
        }

        if (_previewId == attachment.Id)
        {
            _previewId = null;
            _previewText = null;
        }

        await ReloadAsync();
    }

    private async Task TogglePreviewAsync(AttachmentInfo attachment)
    {
        if (_previewId == attachment.Id)
        {
            _previewId = null;
            _previewText = null;
            return;
        }

        _previewId = attachment.Id;
        _previewText = null;
        if (ConversationId is not { } id)
        {
            return;
        }

        var text = await Api.GetAttachmentTextAsync(id, attachment.Id);
        if (_previewId != attachment.Id)
        {
            return;
        }

        if (text.IsSuccess)
        {
            _previewText = text.Value;
        }
        else
        {
            _previewId = null;
            _problem = text.Problem;
        }
    }

    /// <summary>Shows the problem; returns true when the session expired and the page is going away.</summary>
    private async Task<bool> HandleAsync(ApiProblem problem)
    {
        if (problem.IsUnauthorized)
        {
            await OnSessionExpired.InvokeAsync();
            return true;
        }

        _problem = problem;
        return false;
    }

    private static ApiProblem Local(string message) =>
        new(0, "client.attachment", message, new Dictionary<string, string[]>());

    private static Color MeterColor(MeterLevel level) => level switch
    {
        MeterLevel.Warning => Color.Warning,
        MeterLevel.Critical or MeterLevel.Over => Color.Error,
        _ => Color.Primary,
    };
}
