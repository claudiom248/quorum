# Copy to .env and adjust. .env is git-ignored.

# Password of the bundled PostgreSQL (profile "bundled-db"). Required with the bundled database.
POSTGRES_PASSWORD=change-me

# Password of the optional PostgreSQL with pgvector for knowledge bases (profile "pgvector", user "knowledge", database "knowledge").
# Required with that profile. It is a separate database from the platform's; the port is published on this machine only.
# PGVECTOR_PASSWORD=change-me
# PGVECTOR_PORT=5433

# Host address and port the web UI is published on. The default is this machine only; to let other
# machines reach it set QUORUM_BIND=0.0.0.0 and put a TLS reverse proxy in front (the login uses cookies).
# QUORUM_BIND=127.0.0.1
# QUORUM_PORT=8080

# Use your own PostgreSQL (version 15 or later) instead of the bundled one (then start without the bundled-db profile).
# QUORUM_DATABASE=Host=db.example.com;Port=5432;Database=quorum;Username=quorum;Password=...

# Signing key of the bundled SearXNG instance (profile "searxng"). Required with that profile; any long random string will do, e.g.
# openssl rand -base64 24. It is only used by the instance itself, never by Quorum.
# SEARXNG_SECRET=change-me
# Where the instance is published on this machine, to check it in a browser. Quorum reaches it as http://searxng:8080.
# SEARXNG_PORT=8888

# Observability (profile "observability", spec 016). Start with: COMPOSE_PROFILES=observability in .env, then the endpoint below.
# Without the endpoint Quorum exports nothing (the default).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Password of Grafana (the traces viewer), profile "observability". Change it: the default is only for a first try.
# GRAFANA_ADMIN_PASSWORD=change-me
# Where Grafana is published on this machine (loopback only).
# GRAFANA_PORT=3000
# Link from the audit log to a trace, with {traceId} as the placeholder (for example Grafana Explore). Empty: no link.
# QUORUM_TRACE_URL_TEMPLATE=http://127.0.0.1:3000/explore?traceId={traceId}
